---
/** Floating button that scrolls back to the top. Animated in src/scripts/animations.ts. */
---

<button class="back-top_wrap" data-back-to-top aria-label="Back to top">
  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path d="M12 19V5M5 12l7-7 7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
</button>

<style is:global>
  @layer components {
    .back-top_wrap {
      position: fixed;
      left: 2rem;
      bottom: 2rem;
      z-index: 40;
      width: 4rem;
      height: 4rem;
      display: grid;
      place-items: center;
      border-radius: var(--radius-medium);
      border: 0.3rem solid #291d45;
      background-color: var(--purple-400);
      color: var(--light-100);
      visibility: hidden;
      transition: border-width 0.5s cubic-bezier(0.65, 0, 0, 1);
      & svg {
        width: 2.4rem;
        height: 2.4rem;
      }
      @media (hover: hover) {
        &:hover {
          border-width: 0.4rem;
        }
      }
    }
  }
</style>
