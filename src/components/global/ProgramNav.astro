---
/** Slim navbar for program landing pages: institute logo, phone number, Apply Now. */
import Button from "@/components/Button.astro";
import SiteImg from "@/components/media/SiteImg.astro";
import Icon from "@/components/media/Icon.astro";
import phoneIcon from "@/assets/icons/program/phone.svg";

interface Props {
  /** Institute logo (Webflow image path). Use the white logo on the dark bar. */
  logo: string;
  /** Phone number. */
  phone: string;
  /** Bar colour: white (default) or black for dark pages like the thank-you page. */
  theme?: "light" | "dark";
  /** Where Apply Now goes. Defaults to the form at the top of the page. */
  applyHref?: string;
}

const { logo, phone, theme = "light", applyHref = "#header" } = Astro.props;
const external = applyHref.startsWith("http");
---

<header class:list={["program-nav_wrap", theme === "dark" && "is-dark"]}>
  <div class="program-nav_bar">
    <a class="program-nav_logo" href="#top" aria-label="Back to top">
      <SiteImg src={logo} alt="Indian Institute of Technology Jodhpur" loading="eager" size={320} transparent />
    </a>
    <div class="program-nav_actions">
      <a class="program-nav_phone" href={`tel:${phone}`}>
        <Icon src={phoneIcon} />
        <span>{phone}</span>
      </a>
      <Button element="link" href={applyHref} target={external ? "_blank" : undefined} rel={external ? "noopener" : undefined}>Apply Now</Button>
    </div>
  </div>
</header>

<style is:global>
  @layer components {
    .program-nav_wrap {
      position: fixed;
      inset: 0 0 auto;
      z-index: 100;
      background-color: var(--light-100);
      color: var(--dark-900);
      &.is-dark {
        background-color: var(--dark-900);
        color: var(--light-100);
        border-bottom: var(--border-width) solid rgb(255 255 255 / 0.1);
      }
    }
    .program-nav_bar {
      height: 4.5rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      padding-inline: var(--site-margin);
    }
    .program-nav_logo {
      display: block;
      & img {
        width: auto;
        height: 3.5rem;
        @media (width < 48rem) {
          height: 2.75rem;
        }
      }
    }
    .program-nav_actions {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }
    .program-nav_phone {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin-right: 0.75rem;
      font-size: 1.125rem;
      color: rgb(0 0 0 / 0.8);
      .is-dark & {
        color: rgb(255 255 255 / 0.85);
      }
      & .icon {
        width: 1.25rem;
      }
      @media (width < 48rem) {
        display: none;
      }
    }
  }
</style>
