---
/**
 * Marketing tags copied from futurense.com (Webflow site settings and custom code):
 * Google Ads + Google Analytics (gtag.js), Google Tag Manager and Microsoft Clarity.
 *
 * They only run on the real Futurense domains (see LIVE_HOSTS), so preview copies (GitHub Pages, local) never
 * count visits or ad conversions.
 *
 * These tags cost phones about 3 seconds of processing, so on landing pages they load on the visitor's first
 * interaction (scroll, tap, key press or mouse move). Anyone who fills in the form interacts, so ad click
 * tracking still works. Pages that report a conversion (thank-you pages) load them straight away.
 */

interface Props {
  /** Google Ads conversion to report on this page, e.g. "AW-16634577510/bmz4CKzQ4-0aEOaE_vs9". */
  conversion?: string;
}

import { LIVE_HOSTS } from "@/consts.ts";

const { conversion } = Astro.props;

const config = {
  hosts: LIVE_HOSTS,
  ads: "AW-16634577510",
  analytics: "G-09S1J7F1NM",
  gtm: "GTM-WLG7RVMT",
  clarity: "owrz7ebjgx",
  conversion: conversion ?? null,
};
---

<script is:inline define:vars={{ config }}>
  (function () {
    if (!config.hosts.includes(location.hostname) || window.__leadBlocked) return;

    // Queue for Google tags, ready before the scripts arrive.
    window.dataLayer = window.dataLayer || [];
    window.gtag = function () { window.dataLayer.push(arguments); };

    var started = false;
    var events = ["pointerdown", "touchstart", "keydown", "scroll", "wheel", "mousemove"];
    function start() {
      if (started) return;
      started = true;
      events.forEach(function (e) { removeEventListener(e, start, { passive: true }); });
      load();
    }
    if (config.conversion) start();
    else events.forEach(function (e) { addEventListener(e, start, { passive: true, once: true }); });

    function load() {
    // Google tag (gtag.js): Google Ads + Google Analytics
    var g = document.createElement("script");
    g.async = true;
    g.src = "https://www.googletagmanager.com/gtag/js?id=" + config.ads;
    document.head.appendChild(g);
    window.gtag("js", new Date());
    window.gtag("config", config.ads);
    window.gtag("config", config.analytics);
    // One conversion per form submission, so refreshing the thank-you page doesn't count twice.
    if (config.conversion) {
      var lead = null, sent = null;
      try { lead = sessionStorage.getItem("futurense-lead"); sent = sessionStorage.getItem("futurense-lead-sent"); } catch (e) {}
      if (lead && lead !== sent) {
        window.gtag("event", "conversion", { send_to: config.conversion });
        try { sessionStorage.setItem("futurense-lead-sent", lead); } catch (e) {}
      }
    }

    // Google Tag Manager
    window.dataLayer.push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
    var t = document.createElement("script");
    t.async = true;
    t.src = "https://www.googletagmanager.com/gtm.js?id=" + config.gtm;
    document.head.appendChild(t);

    // Microsoft Clarity
    (function (c, l, a, r, i, t, y) {
      c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments); };
      t = l.createElement(r); t.async = 1; t.src = "https://www.clarity.ms/tag/" + i;
      y = l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t, y);
    })(window, document, "clarity", "script", config.clarity);
    }
  })();
</script>
