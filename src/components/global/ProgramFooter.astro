---
/** Footer for program landing pages: contacts, institute and Futurense logos, help card. */
import SiteImg from "@/components/media/SiteImg.astro";
import Icon from "@/components/media/Icon.astro";
import phoneIcon from "@/assets/icons/program/phone.svg";
import mailIcon from "@/assets/icons/program/mail.svg";
import poweredLogo from "@/assets/icons/program/futurense-uni-logo.svg";

interface Props {
  /** White institute logo (Webflow image path). */
  logo: string;
  /** Phone number. */
  phone: string;
  /** General contact email. */
  email?: string;
  /** Email for program support. */
  supportEmail?: string;
}

const { logo, phone, email = "info@futurense.com", supportEmail = "support@futurense.com" } = Astro.props;
---

<footer class="program-footer_wrap">
  <div class="program-footer_inner">
    <ul class="program-footer_contacts" role="list">
      <li><Icon src={phoneIcon} /><a href={`tel:${phone}`}>{phone}</a></li>
      <li><Icon src={mailIcon} /><a href={`mailto:${email}`}>{email}</a></li>
    </ul>
    <div class="program-footer_logos">
      <SiteImg class="program-footer_logo" src={logo} alt="Logo of the Indian Institute of Technology Jodhpur" size={320} transparent />
      <span class="program-footer_divider" aria-hidden="true"></span>
      <div class="program-footer_powered">
        <span>Powered By</span>
        <Icon src={poweredLogo} />
      </div>
    </div>
    <div class="program-footer_help">
      <p class="program-footer_help_title">Need Help?</p>
      <p>For any program-related queries or assistance, reach out to us at</p>
      <a class="program-footer_help_mail" href={`mailto:${supportEmail}`}>
        <Icon src={mailIcon} />{supportEmail}
      </a>
    </div>
  </div>
</footer>

<style is:global>
  @layer components {
    .program-footer_wrap {
      background-color: var(--dark-900);
      color: var(--light-100);
      padding: 3rem var(--site-margin) 5rem;
    }
    .program-footer_inner {
      max-width: var(--max-width-main);
      margin-inline: auto;
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      gap: 2rem;
      @media (width < 64rem) {
        grid-template-columns: 1fr;
        justify-items: center;
        text-align: center;
      }
    }
    .program-footer_contacts {
      display: flex;
      flex-direction: column;
      gap: 0.0625rem;
      & li {
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }
      & .icon {
        width: 1.25rem;
      }
    }
    .program-footer_logos {
      display: flex;
      align-items: center;
      gap: 1.25rem;
    }
    .program-footer_logo {
      width: auto;
      height: 3.5rem;
    }
    .program-footer_divider {
      width: var(--border-width);
      height: 2.5rem;
      background-color: rgb(255 255 255 / 0.4);
    }
    .program-footer_powered {
      display: flex;
      flex-direction: column;
      gap: 0.125rem;
      font-size: 0.75rem;
      color: #cbd2da;
      & .icon {
        width: 9.5rem;
        aspect-ratio: auto;
        color: var(--light-100);
      }
    }
    .program-footer_help {
      justify-self: end;
      width: 20rem;
      max-width: 100%;
      padding: 1rem;
      border: var(--border-width) solid rgb(255 255 255 / 0.1);
      border-radius: 1rem;
      background-color: var(--brand);
      text-align: start;
      @media (width < 64rem) {
        justify-self: center;
      }
    }
    .program-footer_help_title {
      font-size: 1.25rem;
      font-weight: var(--primary-bold);
      line-height: 1.3;
    }
    .program-footer_help_mail {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin-top: 1rem;
      & .icon {
        width: 1.25rem;
      }
    }
  }
</style>
