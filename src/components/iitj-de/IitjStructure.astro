                        loading="lazy"
                        decoding="async"
                      />
                    </div>
                  </div>
                  <div class="iitj-tcard">
                    <div class="text-size-large iitj-weight-medium iitj-text-ink">
                      Cloud-Native AI Architecture
                    </div>
                    <p class="iitj-text-grey">
                      Scalable AI platforms with data lakes, warehouses, and ML
