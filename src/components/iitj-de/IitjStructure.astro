        row-gap: 0;
        display: flex;
      }
    }
    @media screen and (max-width: 47.9375rem) {
      .iitj-track {
        grid-template-rows: auto;
        grid-template-columns: 1fr 1fr;
        display: none;
      }
    }
    @media screen and (max-width: 47.9375rem) {
