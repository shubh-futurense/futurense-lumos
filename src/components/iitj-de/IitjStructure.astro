                    </p>
                    <div class="iitj-tcard_ic">
                      <img
                        src="https://cdn.prod.website-files.com/687e11ae076e4c47d227af38/6adbca33e0b043498cf3bee4_iitj-de-node-2.svg"
                        alt=""
                        class="iitj-img-contain"
                        loading="lazy"
                        decoding="async"
                      />
                    </div>
                  </div>
                </div>
              </div>
              <div data-w-tab="Tab 2" class="w-tab-pane">
                <div class="iitj-tabs_cards">
                  <div class="iitj-tcard">
                    <div class="text-size-large iitj-weight-medium iitj-text-ink">
                      Generative AI and LLM Applications
                    </div>
                    <p class="iitj-text-grey">
                      Prompt, fine-tune, and deploy GenAI solutions with
                      frontier models.
                    </p>
                    <div class="iitj-tcard_ic">
                      <img
                        src="https://cdn.prod.website-files.com/687e11ae076e4c47d227af38/6adbca360f67c5ccffa28bbb_iitj-de-node-3.svg"
                        alt=""
                        class="iitj-img-contain"
                        loading="lazy"
                        decoding="async"
                      />
                    </div>
                  </div>
                  <div class="iitj-tcard">
                    <div class="text-size-large iitj-weight-medium iitj-text-ink">
                      Agentic AI Systems
                    </div>
                    <p class="iitj-text-grey">
                      Autonomous workflows with LangChain, LangGraph, and
                      Microsoft AutoGen.
                    </p>
                    <div class="iitj-tcard_ic">
                      <img
                        src="https://cdn.prod.website-files.com/687e11ae076e4c47d227af38/6adbca38bf936e5ce3053714_iitj-de-node-4.svg"
                        alt=""
                        class="iitj-img-contain"
                        loading="lazy"
                        decoding="async"
                      />
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // "Read more" on the stage cards.
  document
    .querySelectorAll<HTMLAnchorElement>(".iitj-stage_more")
    .forEach((link) => {
      link.setAttribute("role", "button");
      link.addEventListener("click", (e) => {
        e.preventDefault();
        const stage = link.closest(".iitj-stage");
        if (!stage) return;
        link.textContent = stage.classList.toggle("is-open")
          ? "Read less"
          : "Read more";
      });
    });

  // Tabs (shown on tablets and phones instead of the four-step diagram).
  const tabs = document.querySelector<HTMLElement>("#structure .w-tabs");
  if (tabs) {
    const links = [...tabs.querySelectorAll<HTMLElement>(".w-tab-link")];
    const panes = [...tabs.querySelectorAll<HTMLElement>(".w-tab-pane")];
    const show = (i: number) => {
      links.forEach((l, j) => {
        l.classList.toggle("w--current", i === j);
        l.setAttribute("aria-selected", String(i === j));
        l.tabIndex = i === j ? 0 : -1;
      });
      panes.forEach((p, j) => p.classList.toggle("w--tab-active", i === j));
    };
    links.forEach((l, i) => {
      l.setAttribute("role", "tab");
      l.addEventListener("click", (e) => {
        e.preventDefault();
        show(i);
      });
    });
    panes.forEach((p) => p.setAttribute("role", "tabpanel"));

    // On phones the cards light up one after another while the tabs are on screen,
    // until the visitor taps a tab.
    if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
      const steps = [
        [0, 0],
        [0, 1],
        [1, -1],
      ];
      let k = 0;
      let timer: ReturnType<typeof setInterval> | null = null;
      let stopped = false;
      const clear = () =>
        tabs
          .querySelectorAll(".iitj-tcard")
          .forEach((c) => c.classList.remove("is-on"));
      const step = () => {
        const [tab, card] = steps[k++ % steps.length];
        show(tab);
        tabs.classList.add("iitj-seq");
        clear();
        const cards = [...panes[tab].querySelectorAll(".iitj-tcard")];
        (card < 0 ? cards : [cards[card]]).forEach((c) =>
          c?.classList.add("is-on"),
        );
      };
      const end = () => {
        if (timer) clearInterval(timer);
        timer = null;
        tabs.classList.remove("iitj-seq");
        clear();
      };
      new IntersectionObserver(
        (e) => {
          if (e[0].isIntersecting) {
            if (
              !timer &&
              !stopped &&
              matchMedia("(max-width: 991px)").matches
            ) {
              step();
              timer = setInterval(step, 2200);
            }
          } else end();
        },
        { threshold: 0.35 },
      ).observe(tabs);
      const stop = () => ((stopped = true), end());
      tabs.addEventListener("touchstart", stop, { passive: true });
      links.forEach((l) =>
        l.addEventListener("click", (e) => e.isTrusted && stop()),
      );
    }
  }
</script>

<style is:global>
  @layer components {
    .w-tabs {
      position: relative;
    }
    .w-tabs:before,
    .w-tabs:after {
      content: " ";
      grid-area: 1 / 1 / 2 / 2;
      display: table;
    }
    .w-tabs:after {
      clear: both;
    }
    .w-tab-menu {
      position: relative;
    }
    .w-tab-link {
      vertical-align: top;
      text-align: left;
      cursor: pointer;
      color: #222;
      background-color: #ddd;
      padding: 0.5625rem 1.875rem;
      text-decoration: none;
      display: inline-block;
      position: relative;
    }
    .w-tab-link.w--current {
      background-color: #c8c8c8;
    }
    .w-tab-link:focus {
      outline: 0;
    }
    .w-tab-content {
      display: block;
      position: relative;
      overflow: hidden;
    }
    .w-tab-pane {
      display: none;
      position: relative;
    }
    .w--tab-active {
      display: block;
    }
    @media screen and (max-width: 29.9375rem) {
      .w-tab-link {
        display: block;
      }
    }
    .heading-style-h4.text-weight-bold {
      font-family: "SF Pro Display", Arial, sans-serif;
      font-weight: 700;
    }
    .iitj-stages_wrap {
      flex-direction: column;
      row-gap: 1.25rem;
      display: flex;
    }
    .iitj-track {
      grid-template-rows: auto;
      grid-template-columns: 535fr 601fr;
      column-gap: 1rem;
      margin-top: 0.75rem;
      display: grid;
      position: relative;
    }
    .iitj-track_seg {
      align-items: baseline;
      column-gap: 0.375rem;
      height: 3rem;
      padding-top: 0.6rem;
      padding-left: 1.25rem;
      padding-right: 1.25rem;
      display: flex;
    }
    .iitj-track_seg.iitj-track_s1.is-ai {
      color: #c2530f;
      background-color: #fbe4d0;
    }
    .iitj-track_seg.iitj-track_s2.is-ai {
      background-color: #c2530f;
    }
    .iitj-track_s1 {
      color: #17204e;
      background-color: #e3ebfc;
      border-top-left-radius: 1.5rem;
      border-bottom-left-radius: 1.5rem;
    }
    .iitj-track_s2 {
      color: #fff;
      background-color: #17204e;
      border-top-right-radius: 1.5rem;
      border-bottom-right-radius: 1.5rem;
      justify-content: flex-end;
    }
    .iitj-track_gate {
      z-index: 2;
      color: #fff;
      background-color: #1f5fd6;
      border-radius: 1.25rem;
      padding: 0.5rem 0.875rem;
      line-height: 1.5;
      position: absolute;
      top: 0.375rem;
      left: 47.1%;
      transform: translateX(-50%);
      box-shadow: 0 0 0 0.1875rem #fff;
    }
    .iitj-track_gate.is-ai {
      background-color: #e8681a;
    }
    .iitj-stages {
      grid-template-rows: auto;
      grid-template-columns: 532fr 604fr;
      column-gap: 1rem;
      display: grid;
    }
    .iitj-stage {
      background-color: #fff;
      border: 0.0625rem solid #e4eaf5;
      border-radius: 1rem;
      flex-direction: column;
      align-items: flex-start;
      row-gap: 0.75rem;
      padding: 1.75rem;
      display: flex;
    }
    .iitj-stage.is-ai {
      border-color: #efe2d7;
    }
    .iitj-pill {
      color: #1f5fd6;
      letter-spacing: 0.03em;
      text-transform: uppercase;
      background-color: #e3ebfc;
      border-radius: 1rem;
      padding: 0.25rem 0.75rem;
    }
    .iitj-flow_wrap {
      flex-direction: column;
      row-gap: 2.5rem;
      margin-top: 1.5rem;
      display: flex;
    }
    .iitj-flow {
      grid-template-rows: auto;
      grid-template-columns: 1fr 1fr 1fr 1fr;
      align-items: end;
      column-gap: 2.5rem;
      display: grid;
    }
    .iitj-node {
      background-color: #e3ebfc;
      border-radius: 0.375rem;
      flex-direction: column;
      row-gap: 0.75rem;
      padding: 1.5rem;
      display: flex;
      position: relative;
      overflow: hidden;
    }
    .iitj-node.iitj-node_1.is-ai,
    .iitj-node.iitj-node_2.is-ai,
    .iitj-node.iitj-node_3.is-ai,
    .iitj-node.iitj-node_4.is-ai {
      background-color: #fbe4d0;
    }
    .iitj-node_1 {
      height: 13.75rem;
    }
    .iitj-node_2 {
      height: 15rem;
    }
    .iitj-node_3 {
      height: 16.25rem;
    }
    .iitj-node_4 {
      height: 17.5rem;
    }
    .iitj-node_ic {
      width: 6.5rem;
      height: 6.5rem;
      position: absolute;
      bottom: -0.5rem;
      right: -0.5rem;
    }
    .iitj-flow_groups {
      grid-template-rows: auto;
      grid-template-columns: 1fr 1fr;
      column-gap: 2.5rem;
      margin-top: -1rem;
      display: grid;
    }
    .iitj-flow_group {
      border-left: 0.0625rem solid #b9c8e6;
      border-bottom-left-radius: 0.25rem;
      align-items: flex-start;
      column-gap: 0.75rem;
      padding-left: 1.25rem;
      display: flex;
    }
    .iitj-flow_group.is-ai {
      border-left-color: #edcbae;
    }
    .iitj-flow_line {
      border-bottom: 0.0625rem solid #b9c8e6;
      border-right: 0.0625rem solid #b9c8e6;
      border-bottom-right-radius: 0.25rem;
      flex-grow: 1;
      height: 0.8rem;
    }
    .iitj-flow_line.is-ai {
      border-bottom-color: #edcbae;
      border-right-color: #edcbae;
    }
    .iitj-stage_gate {
      display: none;
    }
    .iitj-stage_more {
      color: #1f5fd6;
      margin-top: 0.5rem;
      font-size: 0.875rem;
      font-weight: 600;
      text-decoration: none;
      display: inline-block;
    }
    .iitj-stage_more.is-ai {
      color: #e8681a;
    }
    .iitj-stage_end,
    .iitj-tabs {
      display: none;
    }
    .iitj-tabs_menu {
      background-color: #e3ebfc;
      border-radius: 0.5rem;
      grid-template-columns: 1fr 1fr;
      padding: 0.25rem;
      display: grid;
    }
    .iitj-tabs_menu.is-ai {
      background-color: #fbe4d0;
    }
    .iitj-tabs_link {
      color: #0f1022;
      text-align: center;
      background-color: #0000;
      border-radius: 0.375rem;
      padding: 0.9375rem 0.5rem;
      font-size: 0.875rem;
      line-height: 1.2;
      transition:
        background-color 0.2s,
        color 0.2s;
    }
    .iitj-tabs_link.is-ai {
      color: #32221a;
    }
    .iitj-tabs_cards {
      flex-direction: column;
      row-gap: 1.75rem;
      display: flex;
    }
    .iitj-tcard {
      background-color: #e3ebfc;
      border-radius: 0.375rem;
      flex-direction: column;
      row-gap: 0.5rem;
      min-height: 8rem;
      padding: 1.5rem 7rem 1.5rem 1.5rem;
      display: flex;
      position: relative;
    }
    .iitj-tcard.is-ai {
      background-color: #fbe4d0;
    }
    .iitj-tcard_ic {
      width: 6rem;
      height: 6rem;
      position: absolute;
      top: 50%;
      right: 0;
      transform: translate(0, -50%);
    }
    @media screen and (max-width: 61.9375rem) {
      .iitj-flow {
        grid-template-rows: auto;
        grid-template-columns: 1fr 1fr;
        gap: 1.25rem;
        display: none;
      }
    }
    @media screen and (max-width: 61.9375rem) {
      .iitj-node_1,
      .iitj-node_2,
      .iitj-node_3,
      .iitj-node_4 {
