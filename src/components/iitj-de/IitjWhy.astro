---
import SiteImg from "@/components/media/SiteImg.astro";
---

<section id="why" class="iitj-why">
  <div class="padding-global padding-section-medium">
    <div class="container-large">
      <div class="iitj-split">
        <div class="iitj-split_content">
          <h2 class="iitj-why-h">
            <span>No Data, No AI. </span>
            <span class="iitj-text-blue">It’s That Simple.</span>
          </h2>
          <p class="text-size-medium iitj-text-grey">
            Companies are rebuilding around AI, and they need engineers who can
            own the data layer. This program prepares you for that role by
            building the pipelines, platforms, and integrations that LLMs and
            agents depend on in production.
          </p>
        </div>
        <div class="iitj-quote_wrap">
          <div class="iitj-slider-quote">
            <div class="item-slider_cms_wrap swiper iitj-swiper-quote">
              <div class="item-slider_cms_list swiper-wrapper">
                <div class="item-slider_cms_item swiper-slide iitj-slide-full">
                  <div class="iitj-quote">
                    <div class="iitj-quote_img">
                      <SiteImg
                        src="A/6adbc8e24f0e43a9c7eee38b_iitj-de-director.jpg"
                        alt="Prof. Avinash Kumar Agarwal, Director, IIT Jodhpur"
                        class="iitj-img-cover"
                      />
                    </div>
                    <div class="iitj-quote_body">
                      <div class="text-size-tiny iitj-weight-semibold iitj-eyebrow iitj-text-white-70">
                        DIRECTOR
                      </div>
                      <p class="text-size-medium iitj-quote_text">
                        Our vision is to equip learners pursuing the PG Diploma
                        and Executive M.Tech. in Data Engineering and Agentic AI
                        with the necessary modern skills and competencies to
                        participate in a rapidly transforming technological
                        knowledge ecosystem, shaped by data engineering and
                        artificial intelligence.
                      </p>
                      <div class="iitj-quote_author">
                        <div class="text-size-medium iitj-weight-semibold iitj-text-white">
                          Prof. Avinash Kumar Agarwal
                        </div>
                        <div class="text-size-small iitj-text-white-70">
                          Director, IIT Jodhpur
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="item-slider_cms_item swiper-slide iitj-slide-full">
                  <div class="iitj-quote">
                    <div class="iitj-quote_img">
                      <SiteImg
                        src="A/6adf24e0bcf54c4d47a2e568_iitj-de-pd-dip-sankar-banerjee.webp"
                        alt="Prof. Avinash Kumar Agarwal, Director, IIT Jodhpur"
                        class="iitj-img-cover"
                      />
                    </div>
                    <div class="iitj-quote_body">
                      <div class="text-size-tiny iitj-weight-semibold iitj-eyebrow iitj-text-white-70">
                        PROGRAM DIRECTOR
                      </div>
                      <p class="text-size-medium iitj-quote_text">
                        PhD in Computer Science and Engineering, IIIT Hyderabad.
                        Postdoc, Ohio State University.
                        <br />
                        <br />
                        Research: high-performance computing, computing systems,
                        computer architecture, and data analytics.
                      </p>
                      <div class="iitj-quote_author">
                        <div class="text-size-medium iitj-weight-semibold iitj-text-white">
                          <span>Prof. Dip Sankar Banerjee</span>
                        </div>
                        <div class="text-size-small iitj-text-white-70">
                          <span>Associate Professor, IIT Jodhpur</span>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="item-slider_cms_item swiper-slide iitj-slide-full">
                  <div class="iitj-quote">
                    <div class="iitj-quote_img">
                      <SiteImg
                        src="A/6adf24e0a265abb2dd1941d5_iitj-de-pd-subhash-bhagat.webp"
                        alt="Prof. Avinash Kumar Agarwal, Director, IIT Jodhpur"
                        class="iitj-img-cover"
                      />
                    </div>
                    <div class="iitj-quote_body">
                      <div class="text-size-tiny iitj-weight-semibold iitj-eyebrow iitj-text-white-70">
                        PROGRAM DIRECTOR
                      </div>
                      <p class="text-size-medium iitj-quote_text">
                        PhD, Indian Statistical Institute, Kolkata. Postdoctoral
                        fellowships at the University of Quebec in Outaouais and
                        the University of Ottawa.
                        <br />
                        <br />
                        Research: distributed algorithms, autonomous multi-agent
                        systems, swarm robotics, Internet of Robotic Things, and
                        security in distributed computing.
                      </p>
                      <div class="iitj-quote_author">
                        <div class="text-size-medium iitj-weight-semibold iitj-text-white">
                          <span>Prof. Subhash Bhagat</span>
                        </div>
                        <div class="text-size-small iitj-text-white-70">
                          <span>
                            Assistant Professor, Department of Mathematics, IIT
                            Jodhpur
                          </span>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="item-slider_cms_item swiper-slide iitj-slide-full">
                  <div class="iitj-quote">
                    <div class="iitj-quote_img">
                      <SiteImg
                        src="A/6adf305b8ee76d877b3f01aa_iit-jodhpur-campus.webp"
                        alt="Prof. Avinash Kumar Agarwal, Director, IIT Jodhpur"
                        class="iitj-img-cover"
                      />
                    </div>
                    <div class="iitj-quote_body">
                      <div class="text-size-tiny iitj-weight-semibold iitj-eyebrow iitj-text-white-70">
                        ABOUT IIT JODHPUR
                      </div>
                      <p class="text-size-medium iitj-quote_text is-plain is-iit">
                        Established in 2008, IIT Jodhpur is an Institute of
                        National Importance with an 852-acre campus in
                        Rajasthan, known for its interdisciplinary research in
                        AI, data science and engineering.
                      </p>
                      <div class="iitj-quote_author">
                        <div class="text-size-medium iitj-weight-semibold iitj-text-white">
                          Indian Institute of Technology Jodhpur
                        </div>
                        <div class="text-size-small iitj-text-white-70">
                          Jodhpur, Rajasthan
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <div class="item-slider_bullet_wrap iitj-bullets"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Quote slider: one slide at a time, looping every 3 seconds.
  import { whenNear } from "@/scripts/iitj-de/when.ts";
  import { loadSwiper } from "@/scripts/iitj-de/sliders.ts";

  whenNear(
    document.querySelectorAll<HTMLElement>(".iitj-slider-quote"),
    async (component) => {
      const el = component.querySelector<HTMLElement>(".swiper");
      if (!el) return;
      const { Swiper, Pagination, Autoplay } = await loadSwiper();
      new Swiper(el, {
        modules: [Pagination, Autoplay],
        slidesPerView: 1,
        spaceBetween: 120,
        loop: true,
        speed: 600,
        grabCursor: true,
        autoplay: matchMedia("(prefers-reduced-motion: reduce)").matches
          ? false
          : { delay: 3000, disableOnInteraction: false },
        pagination: {
          el: component.querySelector<HTMLElement>(".item-slider_bullet_wrap"),
          bulletClass: "item-slider_bullet_item",
          bulletActiveClass: "is-active",
          bulletElement: "button",
          clickable: true,
        },
      });
    },
  );
</script>

<style is:global>
  @layer components {
    .text-size-medium.iitj-quote_text.is-plain {
      font-style: normal;
    }
    .iitj-why {
      background-color: #f3f7fe;
      background-image: radial-gradient(
        circle at 100% 0,
        #8db4ff38 0%,
        #475a801c 35%,
        #0000 70%
      );
      position: relative;
      overflow: hidden;
    }
    .iitj-why.is-ai {
      background-color: #fbf6f0;
      background-image: radial-gradient(
        circle at 100% 0,
        #f5a65b38 0%,
        #7a46281c 35%,
        #0000 70%
      );
    }
    .iitj-quote_wrap {
      flex-direction: column;
      row-gap: 1rem;
      width: 100%;
      min-width: 0;
      display: flex;
    }
    .iitj-quote {
      background-image: linear-gradient(155deg, #17204e 0%, #1e2b60 100%);
      border-radius: 1.5rem;
      grid-template-rows: auto;
      grid-template-columns: 15.75rem 1fr;
      display: grid;
      overflow: hidden;
      box-shadow:
        0 0 0 1px #8db4ff40,
        0 30px 70px -30px #17204e8c;
    }
    .iitj-quote.is-ai {
      background-image: linear-gradient(155deg, #c2530f 0%, #b04a10 100%);
      box-shadow:
        0 0 0 1px #f5a65b40,
        0 30px 70px -30px #422d238c;
    }
    .iitj-quote_img {
      background-color: #1e2b60;
      background-position: 50%;
      background-size: cover;
      min-height: 26rem;
    }
    .iitj-quote_img.is-ai {
      background-color: #b04a10;
    }
    .iitj-quote_body {
      flex-direction: column;
      row-gap: 1.5rem;
      padding: 2.25rem;
      display: flex;
    }
    .iitj-quote_text {
      color: #fff;
      font-style: italic;
      font-weight: 300;
    }
    .iitj-quote_author {
      flex-direction: column;
      row-gap: 0.25rem;
      margin-top: auto;
      display: flex;
    }
    .iitj-slider-quote {
      flex-direction: column;
      row-gap: 2rem;
      width: 100%;
      min-width: 0;
      display: flex;
      position: relative;
    }
    .iitj-why-h {
      color: #0f1022;
      letter-spacing: -0.062em;
      margin-top: 0;
      margin-bottom: 0;
      font-family: Inter, sans-serif;
      font-size: 2.195rem;
      font-weight: 500;
      line-height: 1.12;
    }
    .iitj-why-h.is-ai {
      color: #32221a;
      letter-spacing: -0.055em;
      font-size: 3.06rem;
      line-height: 1.12;
    }
    @media screen and (max-width: 991px) {
      .iitj-why-h.is-ai {
        font-size: 2.5rem;
      }
    }
    @media screen and (max-width: 767px) {
      .text-size-medium.iitj-quote_text {
        display: none;
      }
    }
    @media screen and (max-width: 767px) {
      .text-size-medium.iitj-quote_text.is-plain.is-iit {
        display: block;
      }
    }
    @media screen and (max-width: 767px) {
      .iitj-quote {
        box-shadow: none;
        background-image: none;
        border-radius: 1rem;
        flex-direction: column;
        grid-template-rows: auto;
        grid-template-columns: 1fr;
        display: flex;
      }
    }
    @media screen and (max-width: 767px) {
      .iitj-quote_img {
        border-top-left-radius: 1rem;
        border-top-right-radius: 1rem;
        min-height: 20rem;
        overflow: hidden;
      }
    }
    @media screen and (max-width: 767px) {
      .iitj-quote_body {
        background-color: #1e2b60;
        border-radius: 0.75rem;
        row-gap: 1rem;
        margin-top: -7rem;
        margin-left: 1rem;
        margin-right: 1rem;
        padding: 1.5rem;
        position: relative;
      }
    }
    @media screen and (max-width: 767px) {
      .iitj-quote_body.is-ai {
        background-color: #b04a10;
      }
    }
    @media screen and (max-width: 767px) {
      .iitj-why-h,
      .iitj-why-h.is-ai {
        font-size: 1.625rem;
        line-height: 1.15;
      }
    }
    .item-slider_cms_wrap.swiper.iitj-swiper-quote {
      overflow: hidden;
      padding: 0 3rem 4.5rem;
      margin: 0 -3rem -4.5rem;
    }
    @media screen and (max-width: 767px) {
      .item-slider_cms_wrap.swiper.iitj-swiper-quote {
        padding: 0 1.25rem 3rem;
        margin: 0 -1.25rem -3rem;
      }
    }
  }
</style>
