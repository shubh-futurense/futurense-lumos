            src="A/6adbc95bbb6e923044e68fd0_iitj-de-band-6.jpg"
            alt="IIT Jodhpur campus"
            class="iitj-img-cover"
          />
        </div>
        <div class="iitj-band_img">
          <SiteImg
            src="A/6adbc95e216dec0f8ceb7982_iitj-de-band-7.jpg"
            alt="IIT Jodhpur campus"
            class="iitj-img-cover"
          />
        </div>
        <div class="iitj-band_img">
          <SiteImg
            src="A/6adbc961f6d96ec170775cb9_iitj-de-band-8.jpg"
            alt="IIT Jodhpur campus"
