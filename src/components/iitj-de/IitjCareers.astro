                      src="https://cdn.prod.website-files.com/687e11ae076e4c47d227af38/6adbca46d5ca6abe6f7bdc8a_iitj-de-rc-1.svg"
                      alt=""
                      class="iitj-img-contain"
                      loading="lazy"
                      decoding="async"
                    />
