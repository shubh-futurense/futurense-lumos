                  </div>
                </div>
              </div>
            </div>
            <p class="text-size-tiny iitj-text-grey">
              *Futurense does not offer employment.
            </p>
          </div>
        </div>
        <div class="iitj-assist_wrap">
          <div class="iitj-heading-48 iitj-text-ink">Career Assistance</div>
          <div class="iitj-assist">
            <div class="iitj-assist_item iitj-assist_item-first">
              <div class="iitj-icon-48">
                <img
                  src="https://cdn.prod.website-files.com/687e11ae076e4c47d227af38/6adbca53cea680fbd63d1d29_iitj-de-assist-resume.svg"
