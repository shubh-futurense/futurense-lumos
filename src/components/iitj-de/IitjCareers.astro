            <div class="iitj-figs">
              <div>
                <div class="iitj-fig">
                  <span class="iitj-stat-56">4.5</span>
                  <span class="text-size-medium iitj-weight-medium iitj-text-blue">
                    <span> &nbsp;<!-- --> years</span>
                  </span>
                </div>
                <div class="text-size-small iitj-text-grey">
                  average experience
                </div>
              </div>
              <div>
                <div class="iitj-fig">
                  <span class="iitj-stat-56">29</span>
                  <span class="text-size-medium iitj-weight-medium iitj-text-blue">
