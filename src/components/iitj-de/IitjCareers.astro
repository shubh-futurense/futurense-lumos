<script>
  import { initItemSliders } from "@/scripts/iitj-de/sliders.ts";
  import { initMarquees } from "@/scripts/iitj-de/marquee.ts";
  import { initLogoStrips } from "@/scripts/iitj-de/logo-strips.ts";
  const section = document.getElementById("careers")!;
  initItemSliders(section);
  initMarquees(section);
  initLogoStrips(section);
</script>

<style is:global>
  @layer components {
    .margin-medium {
      margin: 2rem;
    }
    .margin-bottom.margin-medium {
      margin-bottom: 2rem;
      margin-left: 0;
      margin-right: 0;
    }
    .iitj-careers {
      background-color: #f6f8fc;
      background-image: radial-gradient(
        circle at 0%,
        #6e96d224,
        #374b6912 50%,
        #0000
      );
      position: relative;
      overflow: hidden;
    }
    .iitj-careers.is-ai {
      background-color: #fbf6f0;
      background-image: radial-gradient(
        circle at 0%,
        #f5a65b24,
        #7a462812 50%,
        #0000
      );
    }
    .iitj-role {
      scroll-snap-align: start;
      background-color: #fff;
      border: 1px solid #e4eaf5;
      border-radius: 1rem;
      flex-direction: column;
      row-gap: 0.5rem;
      height: 100%;
      padding: 1.375rem;
      display: flex;
    }
    .iitj-role.is-ai {
      border-color: #efe2d7;
    }
    .iitj-icon-28 {
      flex-shrink: 0;
      width: 28px;
      height: 28px;
      margin-bottom: 0.5rem;
    }
    .iitj-role_title {
      margin-bottom: 0.25rem;
      line-height: 1.25;
    }
    .iitj-band {
      flex: none;
      column-gap: 0.75rem;
      padding-right: 0.75rem;
      display: flex;
      overflow: visible;
    }
    .iitj-band_img {
      background-color: #e3ebfc;
      background-position: 50%;
      background-size: cover;
      border-radius: 1rem;
      flex-shrink: 0;
      width: 28.125rem;
      height: 18.75rem;
    }
    .iitj-band_img.is-ai {
      background-color: #fbe4d0;
    }
    .iitj-learners {
      grid-template-rows: auto;
      grid-template-columns: 1fr 5fr;
      gap: 3rem 4rem;
      display: grid;
    }
    .iitj-learners_left {
      flex-direction: column;
      row-gap: 1rem;
      min-width: 0;
      display: flex;
    }
    .iitj-learners_right {
      flex-direction: column;
      row-gap: 0.75rem;
      min-width: 0;
      display: flex;
    }
    .iitj-figs {
      grid-column-gap: 16px;
      grid-row-gap: 2rem;
      grid-template-rows: auto auto;
      grid-template-columns: 1fr;
      grid-auto-columns: 1fr;
      column-gap: 2.5rem;
      margin-top: 0.5rem;
      display: grid;
    }
    .iitj-fig {
      align-items: baseline;
      display: flex;
    }
    .iitj-stat-56 {
      color: #0f1022;
      letter-spacing: -0.07em;
      font-size: 5rem;
      font-weight: 300;
      line-height: 1;
    }
    .iitj-stat-56.is-ai {
      color: #32221a;
    }
    .iitj-logos {
      grid-column-gap: 0.625rem;
      grid-row-gap: 0.625rem;
      grid-template-rows: auto;
      grid-template-columns: repeat(6, 1fr);
      margin-top: 0.75rem;
      margin-bottom: 0.75rem;
      display: grid;
    }
    .iitj-logo {
      background-color: #fff;
      background-position: 50%;
      background-repeat: no-repeat;
      background-size: contain;
      border-radius: 0.5rem;
      height: 4.375rem;
      box-shadow:
        0 4px 6px #17204e0d,
        0 1px 1px #17204e0d;
    }
    .iitj-logo.is-ai {
      box-shadow:
        0 4px 6px #422d230d,
        0 1px 1px #422d230d;
    }
    .iitj-assist_wrap {
      clip-path: inset(0 -100vmax);
      background-color: #fff;
      flex-direction: column;
      row-gap: 1.25rem;
      padding-top: 31px;
      padding-bottom: 30px;
      display: flex;
      box-shadow: 0 0 0 100vmax #fff;
    }
    .iitj-assist {
      border-top: 0 solid #e4eaf5;
      border-bottom: 0 solid #e4eaf5;
      grid-template-rows: auto;
      grid-template-columns: repeat(4, 1fr);
      display: grid;
    }
    .iitj-assist.is-ai {
      border-top-color: #efe2d7;
      border-bottom-color: #efe2d7;
      grid-template-columns: repeat(5, 1fr);
    }
    .iitj-assist_item {
      border-left: 1px solid #e4eaf5;
      border-right-width: 0;
      flex-direction: column;
      row-gap: 0.5rem;
      padding: 1.75rem 1.75rem 1.75rem 28px;
      display: flex;
    }
