---
---

<section class="iitj-changes">
  <div class="padding-global padding-section-medium">
    <div class="container-large">
      <div class="iitj-inner iitj-inner_tight">
        <div class="iitj-changes_head">
          <h2 class="iitj-heading-48 iitj-text-white">
            The Role of the Data Engineer{" "}
            <span class="iitj-text-blue-light">Is Changing.</span>
          </h2>
          <p class="text-size-large iitj-text-white-80">
            Yesterday, the job was moving data. Today, it is building the
            systems AI runs on.
          </p>
        </div>
      </div>
    </div>
  </div>
  <div
    data-marquee-scroll-speed="10"
    data-marquee-scroll-direction-target=""
    data-marquee-direction="left"
    data-marquee-speed="15"
    data-marquee-duplicate="2"
    class="iitj-cmp_marquee"
  >
    <div data-marquee-scroll-target="" class="iitj-cmp_scroll">
      <div data-marquee-collection-target="" class="iitj-cmp_track">
        <div class="iitj-cmp">
          <div class="iitj-cmp_th">
            <div class="iitj-cmp_ic">
              <div class="iitj-icon-18">
                <img
                  src="https://cdn.prod.website-files.com/687e11ae076e4c47d227af38/6adbca3bbb6e923044e6ce5b_iitj-de-chg-pipelines.svg"
                  alt=""
                  class="iitj-img-contain"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            </div>
            <div class="text-size-tiny text-weight-bold iitj-cmp_label">
              PIPELINES
            </div>
          </div>
          <div class="iitj-cmp_before">
            <div class="text-size-tiny iitj-weight-semibold iitj-tag-before">
              Before
            </div>
            <p class="text-size-small iitj-cmp_old">
              ETL from source to warehouse
            </p>
          </div>
          <div class="iitj-cmp_now">
            <div class="text-size-tiny iitj-weight-semibold iitj-tag-now">
              Now
            </div>
            <p class="iitj-weight-semibold iitj-cmp_new">
              Pipelines that feed AI systems in production
            </p>
          </div>
        </div>
        <div class="iitj-cmp">
          <div class="iitj-cmp_th">
            <div class="iitj-cmp_ic">
              <div class="iitj-icon-18">
                <img
                  src="https://cdn.prod.website-files.com/687e11ae076e4c47d227af38/6adbca3c38d19bcb53c2d6ff_iitj-de-chg-platform.svg"
                  alt=""
                  class="iitj-img-contain"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            </div>
            <div class="text-size-tiny text-weight-bold iitj-cmp_label">
              PLATFORM
            </div>
          </div>
          <div class="iitj-cmp_before">
            <div class="text-size-tiny iitj-weight-semibold iitj-tag-before">
              Before
            </div>
            <p class="text-size-small iitj-cmp_old">
              Data lakes and warehouses
            </p>
          </div>
          <div class="iitj-cmp_now">
            <div class="text-size-tiny iitj-weight-semibold iitj-tag-now">
              Now
            </div>
            <p class="iitj-weight-semibold iitj-cmp_new">
              Cloud-native AI platforms with integrated ML and AI services
            </p>
          </div>
        </div>
        <div class="iitj-cmp">
          <div class="iitj-cmp_th">
            <div class="iitj-cmp_ic">
              <div class="iitj-icon-18">
                <img
                  src="https://cdn.prod.website-files.com/687e11ae076e4c47d227af38/6adbca3e38d19bcb53c2d778_iitj-de-chg-dataflow.svg"
                  alt=""
                  class="iitj-img-contain"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            </div>
            <div class="text-size-tiny text-weight-bold iitj-cmp_label">
              DATA FLOW
            </div>
          </div>
          <div class="iitj-cmp_before">
            <div class="text-size-tiny iitj-weight-semibold iitj-tag-before">
              Before
            </div>
            <p class="text-size-small iitj-cmp_old">Scheduled batch jobs</p>
          </div>
          <div class="iitj-cmp_now">
            <div class="text-size-tiny iitj-weight-semibold iitj-tag-now">
              Now
            </div>
            <p class="iitj-weight-semibold iitj-cmp_new">
              Real-time streaming and adaptive decisions
            </p>
          </div>
        </div>
        <div class="iitj-cmp">
          <div class="iitj-cmp_th">
            <div class="iitj-cmp_ic">
              <div class="iitj-icon-18">
                <img
                  src="https://cdn.prod.website-files.com/687e11ae076e4c47d227af38/6adbca405d719f14c9dff76c_iitj-de-chg-intelligence.svg"
                  alt=""
                  class="iitj-img-contain"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            </div>
            <div class="text-size-tiny text-weight-bold iitj-cmp_label">
              INTELLIGENCE
            </div>
          </div>
          <div class="iitj-cmp_before">
            <div class="text-size-tiny iitj-weight-semibold iitj-tag-before">
              Before
            </div>
            <p class="text-size-small iitj-cmp_old">
              Hands clean data to other teams
            </p>
          </div>
          <div class="iitj-cmp_now">
            <div class="text-size-tiny iitj-weight-semibold iitj-tag-now">
              Now
            </div>
            <p class="iitj-weight-semibold iitj-cmp_new">
              Connects pipelines to LLMs and agents
            </p>
          </div>
        </div>
        <div class="iitj-cmp">
          <div class="iitj-cmp_th">
            <div class="iitj-cmp_ic">
              <div class="iitj-icon-18">
                <img
                  src="https://cdn.prod.website-files.com/687e11ae076e4c47d227af38/6adbca42b44fa638bad52f89_iitj-de-chg-automation.svg"
                  alt=""
                  class="iitj-img-contain"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            </div>
            <div class="text-size-tiny text-weight-bold iitj-cmp_label">
              AUTOMATION
            </div>
          </div>
          <div class="iitj-cmp_before">
            <div class="text-size-tiny iitj-weight-semibold iitj-tag-before">
              Before
            </div>
            <p class="text-size-small iitj-cmp_old">Manual workflows</p>
          </div>
          <div class="iitj-cmp_now">
            <div class="text-size-tiny iitj-weight-semibold iitj-tag-now">
              Now
            </div>
            <p class="iitj-weight-semibold iitj-cmp_new">
              Agentic and multi-agent workflows
            </p>
          </div>
        </div>
        <div class="iitj-cmp">
          <div class="iitj-cmp_th">
            <div class="iitj-cmp_ic">
              <div class="iitj-icon-18">
                <img
                  src="https://cdn.prod.website-files.com/687e11ae076e4c47d227af38/6adbca4465ec2bd867bfe7fe_iitj-de-chg-ownership.svg"
                  alt=""
                  class="iitj-img-contain"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            </div>
            <div class="text-size-tiny text-weight-bold iitj-cmp_label">
              OWNERSHIP
            </div>
          </div>
          <div class="iitj-cmp_before">
            <div class="text-size-tiny iitj-weight-semibold iitj-tag-before">
              Before
            </div>
            <p class="text-size-small iitj-cmp_old">Builds the pipeline</p>
          </div>
          <div class="iitj-cmp_now">
            <div class="text-size-tiny iitj-weight-semibold iitj-tag-now">
              Now
            </div>
            <p class="iitj-weight-semibold iitj-cmp_new">
              Builds, serves, monitors, and scales the system
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { initMarquees } from "@/scripts/iitj-de/marquee.ts";
  initMarquees(document.querySelector(".iitj-changes")!);
</script>

<style is:global>
  @layer components {
    .iitj-changes {
      background-image: linear-gradient(
        155deg,
        #17204e 0%,
        #1e2b60 60%,
        #22336b 100%
      );
      padding-bottom: 4.5rem;
      position: relative;
    }
    .iitj-changes.is-ai {
      background-image: linear-gradient(
        155deg,
        #c2530f 0%,
        #b04a10 60%,
        #a8460f 100%
      );
    }
    .iitj-inner_tight {
      row-gap: 0;
    }
    .iitj-changes_head {
      flex-direction: column;
      row-gap: 1rem;
      display: flex;
    }
    .iitj-text-white-80 {
      color: #fffc;
    }
    .iitj-cmp_track {
      scroll-snap-type: x mandatory;
      flex: none;
      grid-auto-columns: 18.75rem;
      grid-auto-flow: column;
      column-gap: 16px;
      width: auto;
      margin-top: 0;
      padding: 0.5rem 16px 2rem 0;
      scroll-padding-left: 5%;
      scroll-padding-right: 5%;
      display: flex;
      overflow: visible;
    }
    .iitj-cmp {
      scroll-snap-align: start;
      background-color: #fff;
      border-radius: 1rem;
      flex-direction: column;
      flex-shrink: 0;
      row-gap: 1rem;
      width: 18.75rem;
      padding: 1.375rem;
      display: flex;
      box-shadow: 0 10px 15px #00000040;
    }
    .iitj-cmp_th {
      align-items: center;
      column-gap: 0.625rem;
      display: flex;
    }
    .iitj-cmp_ic {
      background-color: #e3ebfc;
      border-radius: 0.5rem;
      flex-shrink: 0;
      justify-content: center;
      align-items: center;
      width: 32px;
      height: 32px;
      display: flex;
    }
    .iitj-cmp_ic.is-ai {
      background-color: #fbe4d0;
    }
    .iitj-cmp_label {
      color: #1f5fd6;
      letter-spacing: 0.05em;
      line-height: 1.3;
    }
    .iitj-cmp_before {
      border-bottom: 1px solid #eef2f9;
      flex-direction: column;
      align-items: flex-start;
      row-gap: 0.375rem;
      padding-bottom: 0.75rem;
      display: flex;
    }
    .iitj-cmp_before.is-ai {
      border-bottom-color: #f4ebe3;
    }
    .iitj-tag-before {
      color: #2f55b8;
      background-color: #e3ebfc;
      border-radius: 0.375rem;
      padding: 0.125rem 0.5rem;
      line-height: 1.4;
    }
    .iitj-cmp_old {
      color: #4b5b86;
    }
    .iitj-cmp_now {
      flex-direction: column;
      align-items: flex-start;
      row-gap: 0.5rem;
      display: flex;
    }
    .iitj-tag-now {
      color: #fff;
      background-color: #1f5fd6;
      border-radius: 0.375rem;
      padding: 0.125rem 0.5rem;
      line-height: 1.4;
    }
    .iitj-cmp_new {
      color: #17204e;
      line-height: 1.45;
    }
    .iitj-cmp_marquee {
      width: 100%;
      margin-top: -3rem;
      margin-bottom: -1rem;
      position: relative;
      overflow: hidden;
    }
    .iitj-cmp_scroll {
      display: flex;
      position: relative;
    }
    @media screen and (max-width: 991px) {
      .iitj-cmp_track {
        padding-left: 0;
        padding-right: 16px;
        display: flex;
        overflow: visible;
      }
    }
    @media screen and (max-width: 767px) {
      .iitj-changes {
        padding-bottom: 2.25rem;
      }
    }
    @media screen and (max-width: 767px) {
      .iitj-cmp_track {
        grid-auto-columns: 16rem;
        column-gap: 0.625rem;
        margin-top: 0;
        padding-top: 1.375rem;
        padding-bottom: 0.25rem;
        padding-right: 0.625rem;
      }
    }
    @media screen and (max-width: 767px) {
      .iitj-cmp {
        border-radius: 12px;
        width: 10.3125rem;
        padding: 0.75rem;
      }
    }
    @media screen and (max-width: 767px) {
      .iitj-cmp_marquee {
        margin-top: -2rem;
        margin-bottom: 0;
      }
    }
    @media screen and (max-width: 767px) {
      .iitj-changes p.text-size-large {
        font-size: 1rem;
        line-height: 1.5;
      }
    }
    @media screen and (max-width: 767px) {
      .iitj-cmp {
        row-gap: 0.75rem;
      }
    }
    @media screen and (max-width: 767px) {
      .iitj-cmp_ic {
        width: 28px;
        height: 28px;
      }
    }
    @media screen and (max-width: 767px) {
      .iitj-cmp_label {
        font-size: 11px;
      }
    }
    @media screen and (max-width: 767px) {
      .iitj-cmp_old {
        font-size: 13px;
        line-height: 1.4;
      }
    }
    @media screen and (max-width: 767px) {
      .iitj-cmp_new {
        font-size: 14px;
        line-height: 1.4;
      }
    }
    @media screen and (max-width: 767px) {
      .iitj-cmp_before {
        padding-bottom: 0.5rem;
      }
    }
  }
</style>
