---
import SiteImg from "@/components/media/SiteImg.astro";
---

<section id="fees" class="iitj-dark iitj-fees">
  <div class="iitj-fees_inr">₹</div>
  <div class="padding-global padding-section-medium iitj-relative">
    <div class="container-large">
      <div class="iitj-inner iitj-inner_fees">
        <h2 class="iitj-heading-48 iitj-text-white">
          Fees and <span class="iitj-text-blue-light">Application</span>
        </h2>
        <div class="iitj-fees_grid">
          <div class="iitj-fees_card">
            <div class="iitj-fees_head">
              <div class="text-size-tiny iitj-weight-semibold iitj-eyebrow iitj-text-blue-light">
                YEAR 1 · PG DIPLOMA
              </div>
              <div class="text-size-tiny iitj-weight-semibold iitj-eyebrow iitj-text-white-70">
                AMOUNT
              </div>
            </div>
            <div class="iitj-fees_row">
              <div class="text-size-medium iitj-text-white-90 is-wrap">
                Programme Fee
              </div>
              <div class="text-size-large iitj-weight-semibold iitj-text-white">
                <span>₹3,25,000</span>
              </div>
            </div>
            <div class="iitj-fees_row">
              <div class="text-size-medium iitj-text-white-90 is-wrap">
                Administrative Fee
              </div>
              <div class="text-size-large iitj-weight-semibold iitj-text-white">
                ₹20,000
              </div>
            </div>
            <div class="iitj-fees_row">
              <div class="text-size-medium iitj-text-white-90 is-wrap">
                <span>Application Fee (included in the programme fee)</span>
              </div>
              <div class="text-size-large iitj-weight-semibold iitj-text-white">
                ₹10,000
              </div>
            </div>
            <div class="iitj-fees_row">
              <div class="text-size-medium iitj-text-white-90 is-wrap">
                Bridge Course
              </div>
              <div class="iitj-weight-medium iitj-text-blue-light">
                Sponsored · No extra cost
              </div>
            </div>
            <div class="iitj-fees_total">
              <div class="text-size-tiny text-weight-bold iitj-eyebrow">
                TOTAL YEAR 1 INVESTMENT
              </div>
              <div class="iitj-fees_total-amt">₹3,55,000</div>
            </div>
          </div>
          <div class="iitj-fees_side">
            <div class="iitj-text-24 iitj-text-white">
              Flexible Payment Options
            </div>
            <div class="iitj-fees_item">
              <div class="text-size-tiny iitj-weight-semibold iitj-eyebrow iitj-text-blue-light">
                EMI OPTIONS
              </div>
              <div class="iitj-emi">
                <div class="text-size-small iitj-weight-semibold iitj-emi_dot">
                  6
                </div>
                <div class="text-size-small iitj-weight-semibold iitj-emi_dot">
                  9
                </div>
                <div class="text-size-small iitj-weight-semibold iitj-emi_dot">
                  12
                </div>
                <div class="text-size-small iitj-weight-semibold iitj-emi_dot">
                  24
                </div>
                <div class="text-size-small iitj-text-white-70">months</div>
              </div>
            </div>
            <div class="iitj-fees_item">
              <div class="text-size-tiny iitj-weight-semibold iitj-eyebrow iitj-text-blue-light">
                PAY YOUR WAY
              </div>
              <div class="iitj-text-white">
                UPI, net banking and credit/debit cards
              </div>
            </div>
            <div class="iitj-fees_item iitj-fees_item-last">
              <div class="text-size-tiny iitj-weight-semibold iitj-eyebrow iitj-text-blue-light">
                FINANCING PARTNERS
              </div>
              <div class="iitj-partners">
                <div class="iitj-partner">
                  <SiteImg
                    src="A/6adfaa9e4505005406ed3fd2_iitj-partner-propelld-logo.png"
                    alt="Propelld"
                    class="iitj-partner_img"
                    transparent
                  />
                </div>
                <div class="iitj-partner">
                  <SiteImg
                    src="A/6adfaa9e0f6ce87d04559efc_iitj-partner-avanse-logo.png"
                    alt="Avanse"
                    class="iitj-partner_img"
                    transparent
                  />
                </div>
                <div class="iitj-partner">
                  <SiteImg
                    src="A/6adfaa9f87bd2d81d9466243_iitj-partner-indian-bank-logo.png"
                    alt="Indian Bank"
                    class="iitj-partner_img"
                    transparent
                  />
                </div>
              </div>
            </div>
            <div class="iitj-fees_ctas">
              <a href="#apply" class="iitj-btn iitj-btn_lg">
                Submit your application
              </a>
              <a
                id="whatsapp-link"
                href="#"
                data-phone="919958815791"
                class="iitj-btn iitj-btn_lg iitj-btn_outline"
              >
                Speak with an admissions counsellor
              </a>
            </div>
          </div>
        </div>
        <div class="iitj-y2">
          <div class="iitj-y2_amt">
            <div class="iitj-y2_head">
              <div class="text-size-tiny iitj-weight-semibold iitj-eyebrow iitj-text-blue-light">
                YEAR 2 · EXECUTIVE M.TECH. PATHWAY
              </div>
              <div class="text-size-tiny text-weight-bold iitj-y2_gate">
                CGPA 6.0+
              </div>
            </div>
            <div class="iitj-y2_price">₹2,40,000</div>
            <div class="text-size-tiny iitj-eyebrow iitj-text-white-70">
              ADDITIONAL INVESTMENT{" "}
              <span class="text-color-white-20">(Optional)</span>
            </div>
          </div>
          <div class="iitj-y2_txt">
            <p class="text-size-medium iitj-text-white">
              Progress to the Executive M.Tech. in one additional year, subject
              to eligibility and approval.
            </p>
            <p class="iitj-text-white-75">
              Minimum PG Diploma CGPA of 6.0 and other progression requirements
              apply. See the eligibility section for details.
            </p>
          </div>
        </div>
        <p class="text-size-tiny iitj-text-white-60">
          *The administrative fee includes lodging during immersion and excludes
          meals. No refunds after the last date of registration. Fees are
          subject to change as per the institute's policy.
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  // "Speak with an admissions counsellor" opens WhatsApp with this page's link.
  const wa = document.getElementById("whatsapp-link");
  wa?.addEventListener("click", (e) => {
    e.preventDefault();
    const text = `${wa.dataset.message || "Hi! I want to know more about the program"}\nPage: ${location.href}`;
    location.href = `https://api.whatsapp.com/send?phone=${wa.dataset.phone}&text=${encodeURIComponent(text)}`;
  });
</script>

<style is:global>
  @layer components {
    .text-size-medium.iitj-text-white-90.is-wrap {
      white-space: normal;
      flex: 1;
      min-width: 0;
    }
    .text-color-white-20 {
      color: var(--_primitives---opacity--white-20);
    }
    .iitj-text-24 {
      letter-spacing: -0.05em;
      font-size: 1.5rem;
      font-weight: 500;
      line-height: 1.2;
    }
    .iitj-text-24.iitj-text-ink.is-ai {
      color: #32221a;
    }
    .iitj-fees {
      overflow: hidden;
    }
    .iitj-fees_inr {
      z-index: 0;
      opacity: 0.08;
      color: #1f5fd6;
      font-size: 38.75rem;
      font-weight: 300;
      line-height: 1;
      position: absolute;
      top: 11rem;
      right: -1rem;
    }
    .iitj-fees_inr.is-ai {
      color: #e8681a;
    }
    .iitj-inner_fees {
      row-gap: 2.5rem;
    }
    .iitj-text-white-90 {
      color: #ffffffe6;
    }
    .iitj-text-white-75 {
      color: #ffffffbf;
    }
    .iitj-fees_grid {
      grid-template-rows: auto;
      grid-template-columns: 1.4fr 1fr;
      gap: 2.5rem 3.5rem;
      display: grid;
    }
    .iitj-fees_card {
      background-color: #ffffff0d;
      border: 1px solid #8db4ff38;
      border-radius: 1.25rem;
      flex-direction: column;
      min-width: 0;
      padding: 2rem;
      display: flex;
    }
    .iitj-fees_card.is-ai {
      border-color: #f5a65b38;
    }
    .iitj-fees_head {
      border-bottom: 1px solid #ffffff24;
      justify-content: space-between;
      padding-bottom: 0.75rem;
      display: flex;
    }
    .iitj-fees_row {
      border-bottom: 1px solid #ffffff1a;
      justify-content: space-between;
      align-items: center;
      column-gap: 1rem;
      padding-top: 1.25rem;
      padding-bottom: 1.25rem;
      display: flex;
    }
    .iitj-fees_total {
      color: #17204e;
      background-color: #fff;
      border-radius: 1rem;
      justify-content: space-between;
      align-items: center;
      column-gap: 1rem;
      margin-top: 1.5rem;
      padding: 1.25rem 1.5rem;
      display: flex;
    }
    .iitj-fees_total.is-ai {
      color: #7a2e08;
    }
    .iitj-fees_total-amt {
      letter-spacing: -0.055em;
      font-size: 2.5rem;
      font-weight: 600;
      line-height: 1.5;
    }
    .iitj-fees_side {
      flex-direction: column;
      display: flex;
    }
    .iitj-fees_item {
      border-bottom: 1px solid #ffffff1a;
      flex-direction: column;
      row-gap: 0.75rem;
      padding-top: 0.75rem;
      padding-bottom: 1rem;
      display: flex;
    }
    .iitj-fees_item-last {
      border-bottom-style: none;
    }
    .iitj-emi {
      align-items: center;
      column-gap: 0.5rem;
      display: flex;
    }
    .iitj-emi_dot {
      color: #fff;
      border: 1px solid #8db4ff59;
      border-radius: 18px;
      justify-content: center;
      align-items: center;
      width: 36px;
      height: 36px;
      display: flex;
    }
    .iitj-partners {
      column-gap: 10px;
      display: flex;
    }
    .iitj-partner {
      background-color: #fff;
      background-position: 50%;
      background-repeat: no-repeat;
      background-size: contain;
      border-radius: 8px;
      flex-shrink: 0;
      width: 112px;
      height: 44px;
      padding: 6px 10px;
      overflow: hidden;
    }
    .iitj-fees_ctas {
      flex-direction: column;
      row-gap: 0.75rem;
      margin-top: 1.25rem;
      display: flex;
    }
    .iitj-y2 {
      background-color: #ffffff0d;
      border: 1px solid #8db4ff38;
      border-radius: 1.25rem;
      grid-template-rows: auto;
      grid-template-columns: 26rem 1fr;
      column-gap: 2.5rem;
      padding: 2rem 2.25rem;
      display: grid;
    }
    .iitj-y2.is-ai {
      border-color: #f5a65b38;
    }
    .iitj-y2_amt {
      border-right: 1px solid #8db4ff40;
      flex-direction: column;
      row-gap: 0.75rem;
      padding-right: 2.5rem;
      display: flex;
    }
    .iitj-y2_amt.is-ai {
      border-right-color: #f5a65b40;
    }
    .iitj-y2_head {
      flex-wrap: wrap;
      align-items: center;
      gap: 0.5rem 0.75rem;
      display: flex;
    }
    .iitj-y2_gate {
      color: #17204e;
      background-color: #8db4ff;
      border-radius: 0.75rem;
      padding: 0.25rem 0.625rem;
    }
    .iitj-y2_price {
      color: #fff;
      letter-spacing: -0.065em;
      font-size: 3.5rem;
      font-weight: 600;
      line-height: 1;
    }
    .iitj-y2_txt {
      flex-direction: column;
      justify-content: center;
      row-gap: 0.75rem;
      display: flex;
    }
    .iitj-partner_img {
      object-fit: contain;
      width: 100%;
      height: 100%;
      display: block;
    }
    @media screen and (max-width: 991px) {
      .iitj-fees_inr {
        display: none;
      }
    }
    @media screen and (max-width: 991px) {
      .iitj-fees_grid {
        grid-template-rows: auto;
        grid-template-columns: minmax(0, 1fr);
      }
    }
    @media screen and (max-width: 991px) {
      .iitj-y2 {
        grid-template-rows: auto;
        grid-template-columns: 1fr;
        row-gap: 1.5rem;
      }
    }
    @media screen and (max-width: 991px) {
      .iitj-y2_amt {
        border-bottom: 1px solid #8db4ff40;
        border-right-style: none;
        padding-bottom: 1.5rem;
        padding-right: 0;
      }
    }
    @media screen and (max-width: 991px) {
      .iitj-y2_amt.is-ai {
        border-bottom-color: #f5a65b40;
      }
    }
    @media screen and (max-width: 767px) {
      .iitj-inner.iitj-inner_fees {
        row-gap: 1.5rem;
      }
    }
    @media screen and (max-width: 767px) {
      .iitj-fees_grid {
        row-gap: 1.25rem;
      }
    }
    @media screen and (max-width: 767px) {
      .iitj-fees_card {
        border-radius: 1rem;
        padding: 1.25rem;
      }
    }
    @media screen and (max-width: 767px) {
      .iitj-fees_row {
        padding-top: 0.95rem;
        padding-bottom: 0.95rem;
      }
    }
    @media screen and (max-width: 767px) {
      .iitj-fees_total {
        border-radius: 12px;
        flex-direction: row;
        align-items: center;
        padding: 1rem 1.25rem;
      }
    }
    @media screen and (max-width: 767px) {
      .iitj-fees_total-amt {
        font-size: 2rem;
      }
    }
    @media screen and (max-width: 767px) {
      .iitj-partners {
        flex-wrap: wrap;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 0.5rem;
        display: grid;
      }
    }
    @media screen and (max-width: 767px) {
      .iitj-partner {
        flex-shrink: 0;
        width: auto;
        height: 3rem;
      }
    }
    @media screen and (max-width: 767px) {
      .iitj-y2 {
        padding: 1.25rem;
      }
    }
    @media screen and (max-width: 767px) {
      .iitj-y2_price {
        font-size: 2.5rem;
      }
    }
    @media screen and (max-width: 479px) {
      .iitj-text-24 {
        font-size: 1.25rem;
      }
    }
    @media screen and (max-width: 479px) {
      .iitj-fees_total-amt {
        font-size: 1.75rem;
      }
    }
    @media screen and (max-width: 767px) {
      .iitj-fees_row > * {
        white-space: nowrap;
        letter-spacing: -0.02em;
      }
    }
    @media screen and (max-width: 767px) {
      .iitj-fees_ctas .iitj-btn {
        height: 52px;
        justify-content: center;
        font-size: 1rem;
        border-radius: 6px;
      }
    }
  }
</style>
