<script>
  // "Need Help?" card in the footer: opens and closes with a short animation.
  const card = document.querySelector<HTMLElement>(
    '.support-popup_card.is-absolute[data-help-popup="card"]',
  );
  const trigger = document.querySelector<HTMLElement>(
    '[data-help-popup="trigger"]',
  );
  const closeBtn = document.querySelector<HTMLElement>(
    '[data-help-popup="close"]',
  );
  if (card && trigger && closeBtn) {
    card.setAttribute("data-state", "closed");
    trigger.setAttribute("role", "button");
    trigger.addEventListener("click", (e) => {
      e.preventDefault();
      if (card.getAttribute("data-state") === "open") return;
      card.style.display = "block";
      card.setAttribute("data-state", "open");
    });
    closeBtn.addEventListener("click", () => {
      if (card.getAttribute("data-state") !== "open") return;
      const finish = () => {
        card.setAttribute("data-state", "closed");
        card.style.display = "none";
      };
      if (matchMedia("(prefers-reduced-motion: reduce)").matches)
        return finish();
      card.animate(
        [
          { opacity: 1, transform: "none" },
          { opacity: 0, transform: "translateY(0.75rem) scale(0.98)" },
        ],
        { duration: 200, easing: "ease-in" },
      ).onfinish = finish;
    });
  }
</script>

