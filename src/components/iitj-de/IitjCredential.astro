---
import SiteImg from "@/components/media/SiteImg.astro";
---

<section id="credential" class="iitj-cred">
  <div class="padding-global padding-section-medium">
    <div class="container-large">
      <div class="iitj-cred_grid">
        <div class="iitj-cred_img">
          <SiteImg
            src="A/6adbc96fa144d76de7195eb4_iitj-de-certificate.jpg"
            alt="Sample IIT Jodhpur PG Diploma certificate"
            class="iitj-img-cover"
          />
        </div>
        <div class="iitj-cred_text">
          <h2 class="iitj-heading-48 iitj-text-ink">
            PG Diploma in Data Engineering and Agentic AI{" "}
            <span class="iitj-text-blue">from IIT Jodhpur.</span>
          </h2>
          <p class="text-size-medium iitj-text-ink">
            An academic credential earned through 30 credits, examinations, and
            faculty-assessed work, with a Regular IIT Alumni Status*
          </p>
          <p class="text-size-medium iitj-text-ink">
            A capstone you design, deploy, and present to IIT Jodhpur faculty,
            with credits that carry forward to the Executive M.Tech.*
          </p>
          <p class="text-size-tiny iitj-text-grey">
            *Alumni Status and M.Tech. progression are subject to IIT Jodhpur's
            conditions
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  @layer components {
    .iitj-cred {
      background-color: #f6f8fc;
      background-image: radial-gradient(
        at 100%,
        #6e96d229 0%,
        #374b6914 50%,
        #0000 100%
      );
      position: relative;
    }
    .iitj-cred.is-ai {
      background-color: #fbf6f0;
      background-image: radial-gradient(
        at 100%,
        #f5a65b29 0%,
        #7a462814 50%,
        #0000 100%
      );
    }
    .iitj-cred_grid {
      grid-template-rows: auto;
      grid-template-columns: 1fr 1fr;
      align-items: center;
      gap: 2.5rem 4.5rem;
      padding-left: 1.5rem;
      padding-right: 1.5rem;
      display: grid;
    }
    .iitj-cred_img {
      aspect-ratio: 540 / 385;
      background-color: #efe6cf;
      background-position: 50%;
      background-size: cover;
      border-radius: 0.5rem;
      box-shadow:
        0 1rem 2.5rem #17204e1f,
        0 0.125rem 0.375rem #17204e14;
    }
    .iitj-cred_img.is-ai {
      box-shadow:
        0 1rem 2.5rem #422d231f,
        0 0.125rem 0.375rem #422d2314;
    }
    .iitj-cred_text {
      flex-direction: column;
      row-gap: 1.25rem;
      display: flex;
    }
    @media screen and (max-width: 61.9375rem) {
      .iitj-cred_grid {
        grid-template-rows: auto;
        grid-template-columns: 1fr;
        padding-left: 0;
        padding-right: 0;
      }
    }
  }
</style>
