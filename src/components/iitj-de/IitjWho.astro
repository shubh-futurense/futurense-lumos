---
import SiteImg from "@/components/media/SiteImg.astro";
---

<section id="who" class="iitj-who">
  <div class="iitj-who_bg">
    <SiteImg
      src="A/6adbc8f0aaac0efa4d96c1de_iitj-de-who-bg.jpg"
      alt=""
      class="iitj-img-cover"
    />
  </div>
  <div class="padding-global padding-section-medium iitj-relative">
    <div class="container-large">
      <div class="iitj-inner">
        <div class="iitj-split">
          <div class="iitj-split_content">
            <h2 class="iitj-heading-40 iitj-text-ink">
              Who Is <span class="iitj-text-blue">This For?</span>
            </h2>
            <p class="text-size-medium iitj-text-muted">
              Designed for data, analytics, and software professionals who
              already work with data and want to engineer the systems AI depends
              on: production pipelines, AI-ready data platforms, and the
              integrations that connect enterprise data to LLMs and agents.
            </p>
          </div>
          <div class="iitj-crit">
            <div class="iitj-crit_item">
              <div class="iitj-icon-48">
                <img
                  src="https://cdn.prod.website-files.com/687e11ae076e4c47d227af38/6adbc9d443572f68d1f57f2b_iitj-de-icon-stem.svg"
                  alt=""
                  class="iitj-img-contain"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="text-size-medium iitj-weight-semibold iitj-text-ink">
                STEM degree
              </div>
            </div>
            <div class="iitj-crit_item">
              <div class="iitj-icon-48">
                <img
                  src="https://cdn.prod.website-files.com/687e11ae076e4c47d227af38/6adbc9d6e58115173c6e2455_iitj-de-icon-percent.svg"
                  alt=""
                  class="iitj-img-contain"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="text-size-medium iitj-weight-semibold iitj-text-ink">
                50%+ in UG or PG
              </div>
            </div>
            <div class="iitj-crit_item">
              <div class="iitj-icon-48">
                <img
                  src="https://cdn.prod.website-files.com/687e11ae076e4c47d227af38/6adbc9d89a79bfd56852b25a_iitj-de-icon-briefcase.svg"
                  alt=""
                  class="iitj-img-contain"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="text-size-medium iitj-weight-semibold iitj-text-ink">
                1+ year of work experience
              </div>
            </div>
            <div class="iitj-crit_item">
              <div class="iitj-icon-48">
                <img
                  src="https://cdn.prod.website-files.com/687e11ae076e4c47d227af38/6adbc9da2e1161dd933ad49c_iitj-de-icon-test.svg"
                  alt=""
                  class="iitj-img-contain"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="text-size-medium iitj-weight-semibold iitj-text-ink">
                Pre-screening test
              </div>
            </div>
          </div>
        </div>
        <div class="item-slider_component iitj-slider-io">
          <div class="item-slider_cms_wrap swiper iitj-swiper-io">
            <div class="item-slider_cms_list swiper-wrapper">
              <div class="item-slider_cms_item swiper-slide iitj-slide-full">
                <div class="iitj-io">
                  <div class="iitj-io_side">
                    <div class="iitj-io_ic">
                      <div class="iitj-icon-22">
                        <img
                          src="https://cdn.prod.website-files.com/687e11ae076e4c47d227af38/6adbc9dc689b19545a67b878_iitj-de-icon-io-tech.svg"
                          alt=""
                          class="iitj-img-contain"
                          loading="lazy"
                          decoding="async"
                        />
                      </div>
                    </div>
                    <div>
                      <div class="text-size-tiny iitj-weight-semibold iitj-io_label">
                        You come in as
                      </div>
                      <div class="text-size-xlarge iitj-weight-semibold iitj-text-ink">
                        A software or backend engineer
                      </div>
                    </div>
                  </div>
                  <div class="iitj-io_conn">
                    <div class="iitj-io_node"></div>
                    <div class="iitj-io_line"></div>
                    <div class="iitj-io_node iitj-io_node-on"></div>
                  </div>
                  <div class="iitj-io_side">
                    <div class="iitj-io_ic">
                      <div class="iitj-icon-26">
                        <img
                          src="https://cdn.prod.website-files.com/687e11ae076e4c47d227af38/6adbc9e14f0e43a9c7ef271c_iitj-de-icon-io-leave.svg"
                          alt=""
                          class="iitj-img-contain"
                          loading="lazy"
                          decoding="async"
                        />
                      </div>
                    </div>
                    <div>
                      <div class="text-size-tiny iitj-weight-semibold iitj-io_label iitj-text-blue">
                        You leave with
                      </div>
                      <div class="text-size-xlarge text-weight-bold iitj-text-ink">
                        The ability to connect enterprise data to LLMs, RAG
                        systems, and AI agents
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              <div class="item-slider_cms_item swiper-slide iitj-slide-full">
                <div class="iitj-io">
                  <div class="iitj-io_side">
                    <div class="iitj-io_ic">
                      <div class="iitj-icon-22">
                        <img
                          src="https://cdn.prod.website-files.com/687e11ae076e4c47d227af38/6adbc9ddcea680fbd63d0055_iitj-de-icon-io-mid.svg"
                          alt=""
                          class="iitj-img-contain"
                          loading="lazy"
                          decoding="async"
                        />
                      </div>
                    </div>
                    <div>
                      <div class="text-size-tiny iitj-weight-semibold iitj-io_label">
                        You come in as
                      </div>
                      <div class="text-size-xlarge iitj-weight-semibold iitj-text-ink">
                        A SQL, BI, or data analyst
                      </div>
                    </div>
                  </div>
                  <div class="iitj-io_conn">
                    <div class="iitj-io_node"></div>
                    <div class="iitj-io_line"></div>
                    <div class="iitj-io_node iitj-io_node-on"></div>
                  </div>
                  <div class="iitj-io_side">
                    <div class="iitj-io_ic">
                      <div class="iitj-icon-26">
                        <img
                          src="https://cdn.prod.website-files.com/687e11ae076e4c47d227af38/6adbc9e14f0e43a9c7ef271c_iitj-de-icon-io-leave.svg"
                          alt=""
                          class="iitj-img-contain"
                          loading="lazy"
                          decoding="async"
                        />
                      </div>
                    </div>
                    <div>
                      <div class="text-size-tiny iitj-weight-semibold iitj-io_label iitj-text-blue">
                        You leave with
                      </div>
                      <div class="text-size-xlarge text-weight-bold iitj-text-ink">
                        The engineering depth to move from querying data to
                        building the systems behind it
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              <div class="item-slider_cms_item swiper-slide iitj-slide-full">
                <div class="iitj-io">
                  <div class="iitj-io_side">
                    <div class="iitj-io_ic">
                      <div class="iitj-icon-22">
                        <img
                          src="https://cdn.prod.website-files.com/687e11ae076e4c47d227af38/6adbc9df97b2f0eec3af3e79_iitj-de-icon-io-switch.svg"
                          alt=""
                          class="iitj-img-contain"
                          loading="lazy"
                          decoding="async"
                        />
                      </div>
                    </div>
                    <div>
                      <div class="text-size-tiny iitj-weight-semibold iitj-io_label">
                        You come in as
                      </div>
                      <div class="text-size-xlarge iitj-weight-semibold iitj-text-ink">
                        A data or ETL engineer
                      </div>
                    </div>
                  </div>
                  <div class="iitj-io_conn">
                    <div class="iitj-io_node"></div>
                    <div class="iitj-io_line"></div>
                    <div class="iitj-io_node iitj-io_node-on"></div>
                  </div>
                  <div class="iitj-io_side">
                    <div class="iitj-io_ic">
                      <div class="iitj-icon-26">
                        <img
                          src="https://cdn.prod.website-files.com/687e11ae076e4c47d227af38/6adbc9e14f0e43a9c7ef271c_iitj-de-icon-io-leave.svg"
                          alt=""
                          class="iitj-img-contain"
                          loading="lazy"
                          decoding="async"
                        />
                      </div>
                    </div>
                    <div>
                      <div class="text-size-tiny iitj-weight-semibold iitj-io_label iitj-text-blue">
                        You leave with
                      </div>
                      <div class="text-size-xlarge text-weight-bold iitj-text-ink">
                        The skills to build AI-ready data platforms and run
                        pipelines in production
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="item-slider_bullet_wrap iitj-bullets"></div>
        </div>
        <div class="iitj-mtech">
          <div class="iitj-mtech_cap">
            <img
              src="https://cdn.prod.website-files.com/687e11ae076e4c47d227af38/6adbc9e39a79bfd56852b6bb_iitj-de-icon-mtech-cap.svg"
              alt=""
              class="iitj-img-contain"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="iitj-mtech_text">
            <div class="iitj-weight-semibold iitj-text-white iitj-mtech_label">
              Planning for the M.Tech.?
            </div>
            <p class="text-size-medium iitj-text-white iitj-mtech_lead">
              70% of learners from previous cohorts have progressed to the
              Executive M.Tech. pathway at IIT Jodhpur.
            </p>
            <p class="text-size-medium iitj-text-white">
              You need 60% in UG, First Division, 2 years of work experience,
              and a CGPA of 6.0 or above in the PG Diploma. If you don't meet
              these, you can still complete the PG Diploma, but you cannot
              progress to the M.Tech.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import {
    initItemSliders,
    autoAdvanceOnPhones,
  } from "@/scripts/iitj-de/sliders.ts";
  const section = document.getElementById("who")!;
  initItemSliders(section, (component, swiper) =>
    autoAdvanceOnPhones(component.querySelector(".swiper")!, swiper, 2500),
  );
</script>

<style is:global>
  @layer components {
    .item-slider_component.iitj-slider-io {
      flex-direction: column;
      row-gap: 2rem;
      min-width: 0;
      display: flex;
    }
    .iitj-who {
      background-color: #f3f7fe;
      position: relative;
      overflow: hidden;
    }
    .iitj-who.is-ai {
      background-color: #fbf6f0;
    }
    .iitj-who_bg {
      z-index: 0;
      opacity: 0.82;
      background-position: 50%;
      background-size: cover;
      position: absolute;
      inset: 0;
    }
    .iitj-who_bg.is-ai {
      opacity: 0.12;
    }
    .iitj-text-muted {
      color: #4b5674;
    }
    .iitj-crit {
      grid-column-gap: 1rem;
      grid-row-gap: 1rem;
      grid-template-rows: auto;
      grid-template-columns: 1fr 1fr;
      display: grid;
    }
    .iitj-crit_item {
      background-image: linear-gradient(#f1f5fd 0%, #fff 100%);
      border: 1px solid #e9eef7;
      border-radius: 1rem;
      align-items: center;
      column-gap: 1rem;
      padding: 1rem 1.25rem;
      line-height: 1.3;
      display: flex;
    }
    .iitj-crit_item.is-ai {
      background-image: linear-gradient(#fdf1e7 0%, #fff 100%);
      border-color: #f2e8df;
    }
    .iitj-icon-26 {
      flex-shrink: 0;
      width: 26px;
      height: 26px;
    }
    .iitj-io {
      scroll-snap-align: start;
      background-color: #fff;
      border: 1px solid #c9d6ee;
      border-radius: 1.5rem;
      grid-template-rows: auto;
      grid-template-columns: 1fr 5rem 1fr;
      align-items: center;
      column-gap: 1rem;
      padding: 2rem 1.75rem;
      display: grid;
    }
    .iitj-io.is-ai {
      border-color: #ecd2bd;
    }
    .iitj-io_side {
      align-items: center;
      column-gap: 1rem;
      line-height: 1.2;
      display: flex;
    }
    .iitj-io_ic {
      background-color: #e3ebfc;
      border-radius: 1rem;
      flex-shrink: 0;
      justify-content: center;
      align-items: center;
      width: 56px;
      height: 56px;
      display: flex;
    }
    .iitj-io_ic.is-ai {
      background-color: #fbe4d0;
    }
    .iitj-io_label {
      color: #3a4a78;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      margin-bottom: 0.25rem;
    }
    .iitj-io_conn {
      align-items: center;
      display: flex;
    }
    .iitj-io_node {
      background-color: #fff;
      border: 2px solid #9db1d8;
      border-radius: 5px;
      flex-shrink: 0;
      width: 10px;
      height: 10px;
    }
    .iitj-io_node.iitj-io_node-on.is-ai {
      background-color: #e8681a;
      border-color: #e8681a;
    }
    .iitj-io_node.is-ai {
      border-color: #e3b08a;
    }
    .iitj-io_node-on {
      background-color: #1f5fd6;
      border-color: #1f5fd6;
    }
    .iitj-io_line {
      background-image: linear-gradient(90deg, #c9d6ee 0%, #1f5fd6 100%);
      flex-grow: 1;
      height: 2px;
    }
    .iitj-io_line.is-ai {
      background-image: linear-gradient(90deg, #ecd2bd 0%, #e8681a 100%);
    }
    .iitj-mtech {
      background-color: #1f5fd6;
      border-radius: 1.5rem;
      align-items: center;
      column-gap: 2.5rem;
      padding: 2rem 4.5rem;
      display: flex;
    }
    .iitj-mtech.is-ai {
      background-color: #c2530f;
    }
    .iitj-mtech_cap {
      box-sizing: content-box;
      border-right: 1px solid #ffffff59;
      flex-shrink: 0;
      width: 96px;
      height: 96px;
      padding-right: 2.5rem;
    }
    .iitj-mtech_text {
      flex-direction: column;
      row-gap: 0.75rem;
      display: flex;
    }
    .iitj-mtech_label {
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }
    .iitj-mtech_lead {
      margin-bottom: 0;
      font-weight: 700;
    }
    @media screen and (max-width: 991px) {
      .iitj-io {
        border-radius: 1rem;
        flex-direction: column;
        grid-template-rows: auto;
        grid-template-columns: 1fr;
        align-items: stretch;
        row-gap: 0.875rem;
        padding: 1.125rem 1.125rem 1.25rem;
        display: flex;
        box-shadow:
          0 6px 9px #17204e12,
          0 1px 1px #17204e0f;
      }
    }
    @media screen and (max-width: 991px) {
      .iitj-io.is-ai {
        box-shadow:
          0 6px 9px #422d2312,
          0 1px 1px #422d230f;
      }
    }
    @media screen and (max-width: 991px) {
      .iitj-io_side {
        column-gap: 0.75rem;
      }
    }
    @media screen and (max-width: 991px) {
      .iitj-io_ic {
        border-radius: 0.625rem;
        width: 40px;
        height: 40px;
      }
    }
    @media screen and (max-width: 991px) {
      .iitj-io_label {
        letter-spacing: 0;
        text-transform: none;
        margin-bottom: 0.125rem;
        font-size: 0.8125rem;
        font-weight: 500;
      }
    }
    @media screen and (max-width: 991px) {
      .iitj-io_conn {
        width: auto;
        margin-left: 0.9375rem;
        margin-right: 0;
        transform: none;
      }
    }
    @media screen and (max-width: 991px) {
      .iitj-mtech {
        padding: 2rem;
      }
    }
    @media screen and (max-width: 767px) {
      .iitj-who_bg {
        display: none;
      }
    }
    @media screen and (max-width: 767px) {
      .iitj-crit {
        grid-column-gap: 0.625rem;
        grid-row-gap: 0.625rem;
        grid-template-rows: auto;
        grid-template-columns: 1fr 1fr;
      }
    }
    @media screen and (max-width: 767px) {
      .iitj-crit_item {
        border-style: none;
        border-radius: 0.5rem;
        flex-direction: column;
        align-items: flex-start;
        row-gap: 0.625rem;
        padding: 0.875rem;
      }
    }
    @media screen and (max-width: 767px) {
      .iitj-mtech {
        background-color: #e3ebfc;
        border-radius: 0.5rem;
        flex-direction: column;
        align-items: flex-start;
        row-gap: 0.75rem;
        margin-top: 1.5rem;
        padding: 1.5rem;
      }
    }
    @media screen and (max-width: 767px) {
      .iitj-mtech.is-ai {
        background-color: #fbe4d0;
      }
    }
    @media screen and (max-width: 767px) {
      .iitj-mtech_cap {
        border-right-style: none;
        width: 28px;
        height: 28px;
        padding-right: 0;
      }
    }
    @media screen and (max-width: 767px) {
      .iitj-mtech_text {
        row-gap: 0.5rem;
      }
    }
    @media screen and (max-width: 767px) {
      .iitj-mtech_label {
        text-transform: none;
      }
    }
    .item-slider_cms_wrap.swiper.iitj-swiper-io {
      overflow: hidden;
      margin-left: 0;
      margin-right: 0;
      padding-bottom: 0.75rem;
      margin-bottom: -0.75rem;
    }
    @media screen and (max-width: 991px) {
      .iitj-io .iitj-io_side:last-child .iitj-io_ic {
        display: none;
      }
    }
    @media screen and (max-width: 991px) {
      .iitj-io .text-size-xlarge {
        font-size: 1rem;
        line-height: 1.3;
      }
    }
    @media screen and (max-width: 991px) {
      .iitj-io .iitj-io_side:first-child .iitj-io_label {
        color: #5e606e;
      }
    }
    @media screen and (max-width: 991px) {
      .iitj-io .iitj-io_side:last-child .iitj-io_label {
        color: #1f5fd6;
      }
    }
    @media screen and (max-width: 991px) {
      .iitj-io .iitj-io_side:last-child .text-size-xlarge {
        font-weight: 400;
        color: #17204e;
        line-height: 1.45;
      }
    }
    @media screen and (max-width: 767px) {
      .iitj-who h2 .iitj-text-blue {
        color: inherit;
      }
    }
    @media screen and (max-width: 767px) {
      .iitj-who .iitj-split {
        row-gap: 1.25rem;
      }
    }
    @media screen and (max-width: 767px) {
      .iitj-who .iitj-inner {
        row-gap: 1.5rem;
      }
    }
    @media screen and (max-width: 767px) {
      .iitj-crit_item .iitj-icon-48 {
        width: 22px;
        height: 22px;
      }
    }
    @media screen and (max-width: 767px) {
      .iitj-crit_item .text-size-medium {
        font-size: 1rem;
        line-height: 1.3;
      }
    }
    @media screen and (max-width: 767px) {
      .iitj-mtech [class*="iitj-text-white"] {
        color: #0f1022;
      }
    }
    @media screen and (max-width: 767px) {
      .iitj-mtech .iitj-mtech_label {
        color: #0f1022;
        letter-spacing: 0.12em;
      }
    }
    @media screen and (max-width: 767px) {
      .iitj-mtech .text-size-medium {
        font-size: 1rem;
        line-height: 1.55;
      }
    }
    @media screen and (max-width: 767px) {
      .iitj-mtech_cap img {
        filter: brightness(0) saturate(100%) invert(29%) sepia(83%)
          saturate(2393%) hue-rotate(211deg) brightness(89%) contrast(91%);
      }
    }
  }
</style>
