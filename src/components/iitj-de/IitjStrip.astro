<aside class="iitj-dark iitj-strip">
  <div class="padding-global">
    <div class="container-large">
      <div class="iitj-strip_inner">
        <p class="text-size-medium iitj-text-white">
          Start Date:{" "}
          <strong class="iitj-weight-semibold">January 2027 (Tentative)</strong>
        </p>
        <div class="iitj-btn_group">
          <a href="#apply" class="iitj-btn iitj-btn_lg">
            Apply Now
          </a>
          <a
            data-modal-trigger="brochure"
            href="#brochure"
            class="iitj-btn iitj-btn_lg iitj-btn_outline"
          >
            Download Brochure
          </a>
        </div>
      </div>
    </div>
  </div>
</aside>

<style is:global>
  @layer components {
    .iitj-dark.iitj-strip {
      padding-top: 1.75rem;
      padding-bottom: 1.75rem;
    }
    .iitj-strip {
      padding-top: 1.75rem;
      padding-bottom: 1.75rem;
    }
    .iitj-strip_inner {
      justify-content: space-between;
      align-items: center;
      gap: 1.25rem 2rem;
      min-height: 6.25rem;
      padding-left: 1.5rem;
      padding-right: 1.5rem;
      display: flex;
    }
    .iitj-btn_group {
      flex-wrap: wrap;
      gap: 0.75rem 1rem;
      display: flex;
    }
    @media screen and (max-width: 47.9375rem) {
      .iitj-dark.iitj-strip {
        padding-top: 2.75rem;
        padding-bottom: 3rem;
      }
    }
    @media screen and (max-width: 47.9375rem) {
      .iitj-strip_inner {
        flex-direction: column;
        align-items: stretch;
        row-gap: 1.75rem;
        min-height: 0;
        padding-left: 0;
        padding-right: 0;
      }
    }
    @media screen and (max-width: 47.9375rem) {
      .iitj-strip .iitj-btn_group {
        display: grid;
        grid-template-columns: 1fr 1fr;
        column-gap: 1rem;
        width: 100%;
      }
    }
    @media screen and (max-width: 47.9375rem) {
      .iitj-strip .iitj-btn {
        height: 3.25rem;
        justify-content: center;
        font-size: 1rem;
        border-radius: 0.375rem;
      }
    }
  }
</style>
