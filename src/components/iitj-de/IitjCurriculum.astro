<script>
  // "Show all modules" on phones, where only the first 8 show.
  const more = document.querySelector<HTMLAnchorElement>(".iitj-curr_more");
  const list = document.querySelector<HTMLElement>(".iitj-courses");
  if (more && list) {
    const total = list.querySelectorAll(".iitj-course").length;
    more.textContent = `Show all ${total} modules`;
    more.setAttribute("role", "button");
    more.addEventListener("click", (e) => {
      e.preventDefault();
      const open = list.classList.toggle("is-open");
      more.textContent = open
        ? "Show fewer modules"
        : `Show all ${total} modules`;
      if (!open) list.scrollIntoView({ block: "start", behavior: "smooth" });
    });
  }
</script>

<style is:global>
  @layer components {
    .iitj-curr {
      background-color: #f6f8fc;
      background-image: radial-gradient(
        at 100%,
        #6e96d229 0%,
        #374b6914 50%,
