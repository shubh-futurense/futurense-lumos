      align-items: start;
      column-gap: 4.5rem;
      padding-left: 1.5rem;
      padding-right: 1.5rem;
      display: grid;
    }
    .iitj-curr_head {
      flex-direction: column;
      row-gap: 1rem;
      display: flex;
      position: sticky;
      top: 140px;
    }
    .iitj-cv {
      width: 22.5rem;
      height: 22.5rem;
      margin-top: 1.5rem;
      position: relative;
    }
    .iitj-cv_layer {
      background-color: #8db4ff14;
      border: 1px dashed #1f5fd659;
      border-radius: 0.5rem;
      width: 10rem;
      height: 10rem;
      position: absolute;
      left: 4rem;
      transform: rotate(-26.57deg) skewX(36.87deg) scaleY(0.8);
    }
    .iitj-cv_layer.iitj-cv_l4.is-ai,
    .iitj-cv_layer.iitj-cv_l3.is-ai,
    .iitj-cv_layer.iitj-cv_l2.is-ai {
      background-color: #f5a65b14;
      border-color: #e8681a59;
    }
    .iitj-cv_layer.iitj-cv_l1.is-ai {
      background-color: #e8681a1a;
      border-color: #e8681a80;
    }
    .iitj-cv_l1 {
      background-color: #1f5fd61a;
      border-color: #1f5fd680;
      top: 2.25rem;
    }
    .iitj-cv_l2 {
      top: 4.95rem;
    }
    .iitj-cv_l3 {
      top: 7.6rem;
    }
    .iitj-cv_l4 {
      top: 10.3rem;
    }
    .iitj-curr_main {
      flex-direction: column;
      row-gap: 1rem;
      display: flex;
    }
    .iitj-courses {
      background-color: #fff;
      border: 1px solid #e4eaf5;
      border-radius: 1rem;
      grid-template-rows: auto;
      grid-template-columns: 1fr 1fr;
      column-gap: 1.75rem;
      padding: 0.5rem 1.5rem;
      display: grid;
    }
    .iitj-courses.is-ai {
      border-color: #efe2d7;
    }
    .iitj-course {
      border-bottom: 1px solid #eef2f9;
      align-items: center;
      column-gap: 0.75rem;
      padding-top: 0.75rem;
      padding-bottom: 0.75rem;
      line-height: 1.3;
      display: flex;
    }
    .iitj-course.is-ai {
      border-bottom-color: #f4ebe3;
    }
    .iitj-course_ic {
      background-color: #eaf0fc;
      border-radius: 0.5rem;
      flex-shrink: 0;
      justify-content: center;
      align-items: center;
      width: 30px;
      height: 30px;
      display: flex;
    }
    .iitj-course_ic.is-ai {
      background-color: #fcecdf;
    }
    .iitj-icon-16 {
      flex-shrink: 0;
      width: 16px;
      height: 16px;
    }
    .iitj-exam {
      background-color: #f3f7fe;
      border: 1px solid #e4eaf5;
      border-radius: 1rem;
      padding: 1rem 1.25rem;
    }
    .iitj-exam.is-ai {
      background-color: #fbf6f0;
      border-color: #efe2d7;
    }
    .iitj-exam_text {
      color: #3a4566;
    }
    .iitj-curr_more {
      color: #1f5fd6;
      margin-top: 1rem;
      font-weight: 500;
      text-decoration: none;
      display: none;
    }
    .iitj-curr_more.is-ai {
      color: #e8681a;
    }
    @media screen and (max-width: 991px) {
      .iitj-curr_grid {
        grid-template-rows: auto;
        grid-template-columns: 1fr;
        row-gap: 2.5rem;
        padding-left: 0;
        padding-right: 0;
