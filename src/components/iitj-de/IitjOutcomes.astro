---
import SiteImg from "@/components/media/SiteImg.astro";
---

<section id="outcomes" class="iitj-outcomes">
  <div class="padding-global padding-section-medium">
    <div class="container-large">
      <div class="iitj-inner">
        <div class="item-slider_component iitj-slider">
          <div class="iitj-oc_head">
            <h2 class="iitj-heading-48 iitj-text-ink">
              By the End, <span class="iitj-text-blue">You'll Be Able To</span>
            </h2>
            <div class="iitj-oc_ctrl">
              <div class="item-slider_btn_element is-prev iitj-oc_btn">
                <div class="iitj-icon-20">
                  <img
                    src="https://cdn.prod.website-files.com/687e11ae076e4c47d227af38/6adbc9e5aa00abb5a902704e_iitj-de-icon-arrow-prev.svg"
                    alt="Previous"
                    class="iitj-img-contain"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              </div>
              <div class="item-slider_bullet_wrap iitj-bullets-ctrl"></div>
              <div class="item-slider_btn_element is-next iitj-oc_btn">
                <div class="iitj-icon-20">
                  <img
                    src="https://cdn.prod.website-files.com/687e11ae076e4c47d227af38/6adbc9e6ec8630ea981eaa9a_iitj-de-icon-arrow-next.svg"
                    alt="Next"
                    class="iitj-img-contain"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              </div>
            </div>
          </div>
          <div class="item-slider_cms_wrap swiper iitj-swiper">
            <div class="item-slider_cms_list swiper-wrapper">
              <div class="item-slider_cms_item swiper-slide iitj-slide-oc">
                <div class="iitj-oc_card">
                  <div class="iitj-oc_img">
                    <SiteImg
                      src="A/6adbc8f157ccb3a7ad54cc91_iitj-de-outcome-1.jpg"
                      alt=""
                      class="iitj-img-cover"
                    />
                  </div>
                  <div class="iitj-oc_body">
                    <div class="text-size-medium iitj-weight-medium iitj-text-ink">
                      Build pipelines that feed AI
                    </div>
                    <p class="text-size-small iitj-text-grey">
                      Go beyond ETL and feed AI systems in production.
                    </p>
                  </div>
                </div>
              </div>
              <div class="item-slider_cms_item swiper-slide iitj-slide-oc">
                <div class="iitj-oc_card">
                  <div class="iitj-oc_img">
                    <SiteImg
                      src="A/6adbc8f5a144d76de71938bc_iitj-de-outcome-3.jpg"
                      alt=""
                      class="iitj-img-cover"
                    />
                  </div>
                  <div class="iitj-oc_body">
                    <div class="text-size-medium iitj-weight-medium iitj-text-ink">
                      Design end-to-end data platforms
                    </div>
                    <p class="text-size-small iitj-text-grey">
                      Combine big data systems with LLM-driven intelligence.
                    </p>
                  </div>
                </div>
              </div>
              <div class="item-slider_cms_item swiper-slide iitj-slide-oc">
                <div class="iitj-oc_card">
                  <div class="iitj-oc_img">
                    <SiteImg
                      src="A/6adbc8f95d719f14c9df8f1d_iitj-de-outcome-5.jpg"
                      alt=""
                      class="iitj-img-cover"
                    />
                  </div>
                  <div class="iitj-oc_body">
                    <div class="text-size-medium iitj-weight-medium iitj-text-ink">
                      Build LLM-powered applications
                    </div>
                    <p class="text-size-small iitj-text-grey">
                      Use prompt engineering, fine-tuning, and custom GPT-based
                      solutions.
                    </p>
                  </div>
                </div>
              </div>
              <div class="item-slider_cms_item swiper-slide iitj-slide-oc">
                <div class="iitj-oc_card">
                  <div class="iitj-oc_img">
                    <SiteImg
                      src="A/6adbc8f3216dec0f8ceb417c_iitj-de-outcome-2.jpg"
                      alt=""
                      class="iitj-img-cover"
                    />
                  </div>
                  <div class="iitj-oc_body">
                    <div class="text-size-medium iitj-weight-medium iitj-text-ink">
                      Orchestrate agentic workflows
                    </div>
                    <p class="text-size-small iitj-text-grey">
                      Build multi-agent workflows with LangChain, LangGraph, and
                      Microsoft AutoGen.
                    </p>
                  </div>
                </div>
              </div>
              <div class="item-slider_cms_item swiper-slide iitj-slide-oc">
                <div class="iitj-oc_card">
                  <div class="iitj-oc_img">
                    <SiteImg
                      src="A/6adbc8fb5865fe27f8a47549_iitj-de-outcome-6.jpg"
                      alt=""
                      class="iitj-img-cover"
                    />
                  </div>
                  <div class="iitj-oc_body">
                    <div class="text-size-medium iitj-weight-medium iitj-text-ink">
                      Work with real-time data
                    </div>
                    <p class="text-size-small iitj-text-grey">
                      Build streaming pipelines that drive automation and
                      adaptive decisions.
                    </p>
                  </div>
                </div>
              </div>
              <div class="item-slider_cms_item swiper-slide iitj-slide-oc">
                <div class="iitj-oc_card">
                  <div class="iitj-oc_img">
                    <SiteImg
                      src="A/6adbc8fd9a79bfd568525b36_iitj-de-outcome-7.jpg"
                      alt=""
                      class="iitj-img-cover"
                    />
                  </div>
                  <div class="iitj-oc_body">
                    <div class="text-size-medium iitj-weight-medium iitj-text-ink">
                      Build hybrid AI systems
                    </div>
                    <p class="text-size-small iitj-text-grey">
                      Combine machine learning and deep learning with LLMs and
                      agents.
                    </p>
                  </div>
                </div>
              </div>
              <div class="item-slider_cms_item swiper-slide iitj-slide-oc">
                <div class="iitj-oc_card">
                  <div class="iitj-oc_img">
                    <SiteImg
                      src="A/6adbc8f75d719f14c9df8e58_iitj-de-outcome-4.jpg"
                      alt=""
                      class="iitj-img-cover"
                    />
                  </div>
                  <div class="iitj-oc_body">
                    <div class="text-size-medium iitj-weight-medium iitj-text-ink">
                      Deploy cloud-native AI platforms
                    </div>
                    <p class="text-size-small iitj-text-grey">
                      Serve, monitor, and scale platforms built on data lakes,
                      warehouses, and ML services.
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="iitj-tools_wrap">
          <h3 class="iitj-heading-48 iitj-text-ink">
            <span class="iitj-text-blue">Tools</span> You Will Master
          </h3>
          <div data-tools-mq="" class="iitj-tools_mq">
            <div class="iitj-tools">
              <div data-logo-strip="left" class="iitj-tools_row">
                <div class="iitj-tools_list">
                  <div class="iitj-tool">
                    <div class="iitj-tool_img">
                      <SiteImg
                        src="A/6adbc90c0f67c5ccffa235b7_iitj-de-tool-hadoop.jpg"
                        alt="Python"
                        class="iitj-img-contain"
                        transparent
                      />
                    </div>
                    <div class="text-size-tiny iitj-text-ink">Python</div>
                  </div>
                  <div class="iitj-tool">
                    <div class="iitj-tool_img">
                      <img
                        src="https://cdn.prod.website-files.com/687e11ae076e4c47d227af38/6adfabac4505005406edc088_tool-tensorflow-logo.svg"
                        alt="TensorFlow"
                        class="iitj-img-contain"
                        loading="lazy"
                        decoding="async"
                      />
                    </div>
                    <div class="text-size-tiny iitj-text-ink">TensorFlow</div>
                  </div>
                  <div class="iitj-tool">
                    <div class="iitj-tool_img">
                      <SiteImg
                        src="A/6adbc9155117c6be2d07f064_iitj-de-tool-langchain.jpg"
                        alt="scikit-learn"
                        class="iitj-img-contain"
                        transparent
                      />
                    </div>
                    <div class="text-size-tiny iitj-text-ink">scikit-learn</div>
                  </div>
                  <div class="iitj-tool">
                    <div class="iitj-tool_img">
                      <SiteImg
                        src="A/6adbc901d5ca6abe6f7b474e_iitj-de-tool-tensorflow.jpg"
                        alt="Apache Spark"
                        class="iitj-img-contain"
                        transparent
                      />
                    </div>
                    <div class="text-size-tiny iitj-text-ink">Apache Spark</div>
                  </div>
                  <div class="iitj-tool">
                    <div class="iitj-tool_img">
                      <SiteImg
                        src="A/6adbc918bb6e923044e67646_iitj-de-tool-langgraph.jpg"
                        alt="Apache Kafka"
                        class="iitj-img-contain"
                        transparent
                      />
                    </div>
                    <div class="text-size-tiny iitj-text-ink">Apache Kafka</div>
                  </div>
                  <div class="iitj-tool">
                    <div class="iitj-tool_img">
                      <SiteImg
                        src="A/6adbc90f57ccb3a7ad54d775_iitj-de-tool-sagemaker.jpg"
                        alt="Hadoop"
                        class="iitj-img-contain"
                        transparent
                      />
                    </div>
                    <div class="text-size-tiny iitj-text-ink">Hadoop</div>
                  </div>
                </div>
              </div>
              <div data-logo-strip="right" class="iitj-tools_row">
                <div class="iitj-tools_list">
                  <div class="iitj-tool">
                    <div class="iitj-tool_img">
                      <SiteImg
                        src="A/6adbc909aaac0efa4d96d09a_iitj-de-tool-kafka.jpg"
                        alt="Amazon SageMaker"
                        class="iitj-img-contain"
                        transparent
                      />
                    </div>
                    <div class="text-size-tiny iitj-text-ink">
                      Amazon SageMaker
                    </div>
                  </div>
                  <div class="iitj-tool">
                    <div class="iitj-tool_img">
                      <SiteImg
                        src="A/6adbc912a78196a621ccbd33_iitj-de-tool-redshift.jpg"
                        alt="Amazon Redshift"
                        class="iitj-img-contain"
                        transparent
                      />
                    </div>
                    <div class="text-size-tiny iitj-text-ink">
                      Amazon Redshift
                    </div>
                  </div>
                  <div class="iitj-tool">
                    <div class="iitj-tool_img">
                      <SiteImg
                        src="A/6ae069afdcbf9a8b32dc0f06_langchain%201.avif"
                        alt="LangChain"
                        class="iitj-img-contain"
                        transparent
                      />
                    </div>
                    <div class="text-size-tiny iitj-text-ink">LangChain</div>
                  </div>
                  <div class="iitj-tool">
                    <div class="iitj-tool_img">
                      <img
                        src="https://cdn.prod.website-files.com/687e11ae076e4c47d227af38/6adfabad50bb208644ebf8f7_tool-langgraph-logo.svg"
                        alt="LangGraph"
                        class="iitj-img-contain"
                        loading="lazy"
                        decoding="async"
                      />
                    </div>
                    <div class="text-size-tiny iitj-text-ink">LangGraph</div>
                  </div>
                  <div class="iitj-tool">
                    <div class="iitj-tool_img">
                      <SiteImg
                        src="A/6adbc9072e1d1ef309879bfa_iitj-de-tool-spark.jpg"
                        alt="Microsoft AutoGen"
                        class="iitj-img-contain"
                        transparent
                      />
                    </div>
                    <div class="text-size-tiny iitj-text-ink">
                      Microsoft AutoGen
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <p class="text-size-tiny iitj-text-grey">
            *Tools may vary depending on the subjects finalized.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import {
    initItemSliders,
    autoAdvanceOnPhones,
  } from "@/scripts/iitj-de/sliders.ts";
  import { initLogoStrips } from "@/scripts/iitj-de/logo-strips.ts";
  const section = document.getElementById("outcomes")!;
  initItemSliders(section, (component, swiper) =>
    autoAdvanceOnPhones(component.querySelector(".swiper")!, swiper, 4000),
  );
  initLogoStrips(section);
</script>

<style is:global>
  @layer components {
    .iitj-outcomes {
      background-color: #f6f8fc;
      background-image: radial-gradient(
        circle at 0%,
        #6e96d224,
        #374b6912 50%,
        #0000
      );
      position: relative;
      overflow: hidden;
    }
    .iitj-outcomes.is-ai {
      background-color: #fbf6f0;
      background-image: radial-gradient(
        circle at 0%,
        #f5a65b24,
        #7a462812 50%,
        #0000
      );
    }
    .iitj-oc_card {
      scroll-snap-align: start;
      background-color: #fff;
      border: 1px solid #e4eaf5;
      border-radius: 1rem;
      flex-direction: column;
      height: 100%;
      display: flex;
      overflow: hidden;
    }
    .iitj-oc_card.is-ai {
      border-color: #efe2d7;
    }
    .iitj-oc_img {
      background-color: #f3f7fe;
      background-position: 50%;
      background-size: cover;
      height: 11.625rem;
    }
    .iitj-oc_img.is-ai {
      background-color: #fbf6f0;
    }
    .iitj-oc_body {
      flex-direction: column;
      row-gap: 0.5rem;
      padding: 1.25rem 1.25rem 1.5rem;
      display: flex;
    }
    .iitj-tools_wrap {
      flex-direction: column;
      row-gap: 1.5rem;
      min-width: 0;
      display: flex;
    }
    .iitj-tools {
      grid-column-gap: 0.5rem;
      grid-row-gap: 0.5rem;
      flex-wrap: nowrap;
      flex: none;
      grid-template-rows: auto;
      grid-template-columns: repeat(6, 1fr);
      column-gap: 8px;
      padding-right: 8px;
      display: flex;
    }
    .iitj-tool {
      text-align: center;
      background-color: #fff;
      border: 1px solid #e4eaf5;
      border-radius: 6px;
      flex-direction: column;
      flex-shrink: 0;
      justify-content: center;
      align-items: center;
      row-gap: 0.75rem;
      width: 185.3px;
      height: 6rem;
      display: flex;
    }
    .iitj-tool.is-ai {
      border-color: #efe2d7;
    }
    .iitj-tool_img {
      background-position: 50%;
      background-repeat: no-repeat;
      background-size: contain;
      width: 9.25rem;
      height: 2.5rem;
    }
    .iitj-tools_mq {
      width: 100vw;
      margin-left: calc(50% - 50vw);
      display: flex;
      overflow: hidden;
    }
    .iitj-tools_row,
    .iitj-tools_list {
      display: contents;
    }
    @media screen and (max-width: 991px) {
      .iitj-tools {
        grid-template-rows: auto;
        grid-template-columns: repeat(4, 1fr);
        display: flex;
      }
    }
    @media screen and (max-width: 767px) {
      .iitj-tools {
        flex-direction: column;
        grid-template-rows: auto auto;
        grid-template-columns: repeat(6, 7.25rem);
        grid-auto-columns: auto;
        grid-auto-flow: row;
        row-gap: 10px;
        width: 100%;
        margin-right: 0;
        padding-right: 0;
        display: flex;
        overflow-x: hidden;
      }
    }
    @media screen and (max-width: 767px) {
      .iitj-tool {
        row-gap: 0.5rem;
        width: 112px;
        height: 96px;
        padding-left: 0.25rem;
        padding-right: 0.25rem;
      }
    }
    @media screen and (max-width: 767px) {
      .iitj-tool_img {
        width: 5.5rem;
        height: 2rem;
      }
    }
    @media screen and (max-width: 767px) {
      .iitj-tools_row {
        display: flex;
      }
    }
    @media screen and (max-width: 767px) {
      .iitj-tools_list {
        flex: none;
        column-gap: 10px;
        padding-right: 10px;
        display: flex;
      }
    }
    .item-slider_cms_item.swiper-slide.iitj-slide-oc {
      width: 33.3333%;
      padding-left: 0.5rem;
      padding-right: 0.5rem;
    }
    @media screen and (max-width: 767px) {
      .item-slider_cms_item.swiper-slide.iitj-slide-oc {
        width: 85%;
      }
    }
    @media screen and (max-width: 767px) {
      .iitj-outcomes .iitj-inner {
        row-gap: 2.5rem;
      }
    }
    @media screen and (max-width: 767px) {
      .iitj-outcomes .iitj-tools_wrap {
        row-gap: 0.75rem;
      }
    }
    @media screen and (max-width: 767px) {
      .iitj-tools_wrap h3.iitj-heading-48 {
        font-size: 1.0625rem;
        line-height: 1.3;
        letter-spacing: -0.052em;
        margin-bottom: 0.5rem;
      }
    }
    @media screen and (max-width: 767px) {
      .iitj-oc_body {
        padding: 1.375rem 1.125rem 1.5rem;
      }
    }
    @media screen and (max-width: 767px) {
      .iitj-oc_body .text-size-medium {
        font-size: 1.0625rem;
        line-height: 1.3;
        font-weight: 600;
      }
    }
    @media screen and (max-width: 767px) {
      .iitj-oc_body p.text-size-small {
        font-size: 1rem;
        line-height: 1.55;
      }
    }
  }
</style>
