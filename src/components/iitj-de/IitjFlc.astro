---
import SiteImg from "@/components/media/SiteImg.astro";
---

<section
  id="flc-list"
  class="section_flc-marquee overflow-hidden iitj-flc-navy"
>
  <div class="padding-global padding-section-medium">
    <div class="container-large">
      <div class="margin-bottom margin-large">
        <div class="text-align-center">
          <div class="margin-bottom margin-xsmall">
            <h2 class="heading-style-h1 iitj-flc-title">
              <span>Mentored by<!-- -->&nbsp;</span>
              <span class="iitj-flc-accent">
                <span>Industry Experts</span>
              </span>
            </h2>
          </div>
          <div class="max-width-medium align-center">
            <p class="text-size-medium text-color-3 iitj-flc-sub">
              A collective of CXOs, AI leaders, and digital transformation heads
              from global and Fortune 500 companies shaping the AI-native
              workforce.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="contents z-index-2">
    <div class="margin-bottom margin-huge">
      <div
        data-marquee-duplicate="2"
        data-marquee-scroll-direction-target=""
        data-marquee-direction="right"
        data-marquee-status="normal"
        data-marquee-speed="15"
        data-marquee-scroll-speed="10"
        class="marquee-advanced overflow-visible"
      >
        <div
          data-marquee-scroll-target=""
          class="marquee-advanced__scroll w-dyn-list"
        >
          <div
            data-marquee-collection-target=""
            role="list"
