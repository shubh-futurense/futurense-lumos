<script>
  // Section menu, mobile bottom bar and "Apply Now" jumps, ported from the live page's script.
  const nav = document.querySelector<HTMLElement>("[data-snav]");
  const hero = document.querySelector<HTMLElement>(".iitj-hero");
  if (nav && hero) {
    // The menu slides in once the hero has scrolled away.
    new IntersectionObserver(
      (e) => (nav.style.transform = e[0].isIntersecting ? "" : "none"),
      { rootMargin: "-80px 0px 0px 0px" },
    ).observe(hero);
    const links = [
      ...nav.querySelectorAll<HTMLAnchorElement>(".iitj-snav_link"),
    ];
    const row = nav.querySelector<HTMLElement>(".iitj-snav_links")!;
    let current: string | null = null;
    const highlight = (id: string | null) => {
      if (current === id) return;
      current = id;
      links.forEach((a) => {
        const on = a.getAttribute("href") === `#${id}`;
        a.style.backgroundColor = on ? "#1f5fd6" : "";
        a.style.color = on ? "#fff" : "";
        if (on && row.scrollWidth > row.clientWidth)
          row.scrollTo({
            left: a.offsetLeft - row.offsetLeft - 24,
            behavior: "smooth",
          });
      });
    };
    let ticking = false;
    const spy = () => {
      ticking = false;
      let active: string | null = null;
      links.forEach((a) => {
        const section = document.getElementById(
          a.getAttribute("href")!.slice(1),
        );
        if (!section) return;
        const r = section.getBoundingClientRect();
        if (r.top <= 140 && r.bottom > 140) active = section.id;
      });
      highlight(active);
    };
    addEventListener(
      "scroll",
      () => {
        if (!ticking) requestAnimationFrame(spy);
        ticking = true;
      },
      { passive: true },
    );
    links.forEach((a) =>
      a.addEventListener("click", (e) => {
        const section = document.getElementById(
          a.getAttribute("href")!.slice(1),
        );
        if (!section) return;
        e.preventDefault();
        scrollTo({
          top: section.getBoundingClientRect().top + scrollY - 108,
          behavior: "smooth",
        });
      }),
    );
  }

  // Mobile bottom bar: shows once the form is out of view, hides while typing in it.
  const bar = document.querySelector<HTMLElement>("[data-mbar]");
  const form = document.getElementById("apply");
  if (bar && form) {
    let past = false;
    let typing = false;
    const update = () => (bar.style.transform = past && !typing ? "none" : "");
    new IntersectionObserver((e) => {
      past = !e[0].isIntersecting && e[0].boundingClientRect.top < 0;
      update();
    }).observe(form);
    form.addEventListener("focusin", () => ((typing = true), update()));
    form.addEventListener("focusout", () =>
      setTimeout(
        () => ((typing = form.contains(document.activeElement)), update()),
        50,
      ),
    );
  }
  document
    .querySelectorAll<HTMLAnchorElement>('a[href="#apply"]')
    .forEach((a) =>
      a.addEventListener("click", (e) => {
        e.preventDefault();
        scrollTo({
          top: form ? form.getBoundingClientRect().top + scrollY - 90 : 0,
          behavior: "smooth",
        });
      }),
    );
</script>

