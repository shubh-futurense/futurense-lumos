---
/** Admission steps beside a student photo, over a light grid pattern. */
import Heading from "@/components/typography/Heading.astro";
import Button from "@/components/Button.astro";
import SiteImg from "@/components/media/SiteImg.astro";
import { img } from "@/data/site.ts";

interface Props {
  steps: {
    title: string;
    image: string;
    alt: string;
    button: { label: string; href: string };
    items: readonly { step: string; title: string; text: string }[];
    pattern: string;
  };
}

const { steps } = Astro.props;
---

<section class="program-steps_wrap" style={`--_pattern: url('${img(steps.pattern)}');`}>
  <div class="program-steps_layout">
    <div class="program-steps_intro">
      <Heading class="margin-top-0" tag="h2" variant="h3" maxWidth={16}>{steps.title}</Heading>
      <SiteImg class="program-steps_image" src={steps.image} alt={steps.alt} size={440} />
      <div class="program-steps_action">
        <Button element="link" href={steps.button.href} emphasis="secondary" target="_blank" rel="noopener">{steps.button.label}</Button>
      </div>
    </div>
    <ol class="program-steps_list">
      {steps.items.map((s) => (
        <li class="program-steps_item" data-reveal>
          <span class="program-steps_number">{s.step}</span>
          <div>
            <h3 class="program-steps_title">{s.title}</h3>
            <p class="program-steps_text">{s.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style is:global>
  @layer components {
    .program-steps_wrap {
      position: relative;
      padding: var(--section-space-medium) var(--site-margin);
      background: var(--_pattern) center / cover, linear-gradient(var(--light-100) 50%, #efe8ff);
      color: var(--dark-900);
    }
    .program-steps_layout {
      max-width: var(--max-width-main);
      margin-inline: auto;
      display: grid;
      grid-template-columns: 0.57fr 1fr;
      gap: 2rem;
      @media (width < 64rem) {
        grid-template-columns: 1fr;
      }
    }
    .program-steps_intro {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
    }
    .program-steps_image {
      width: 25rem;
      max-width: 100%;
      margin-top: 2rem;
    }
    .program-steps_action {
      align-self: stretch;
      max-width: 25rem;
      display: flex;
      justify-content: center;
      margin-top: 1rem;
    }
    .program-steps_list {
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-content: start;
      margin-top: 4.5rem;
      @media (width < 64rem) {
        grid-template-columns: 1fr;
        margin-top: 0;
      }
    }
    .program-steps_item {
      display: grid;
      grid-template-columns: 3.25rem 1fr;
      gap: 0.75rem;
      padding: 1.5rem 0.75rem;
      border-top: var(--border-width) solid var(--purple-400);
    }
    .program-steps_number {
      color: var(--brand-red);
      line-height: 1.5;
    }
    .program-steps_title {
      margin-bottom: 0.25rem;
      font-size: 1.25rem;
      font-weight: var(--primary-medium);
      line-height: 1.4;
    }
    .program-steps_text {
      color: #323e4a;
    }
  }
</style>
