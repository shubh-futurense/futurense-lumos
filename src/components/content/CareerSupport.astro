---
import Section from "@/components/wrapper/Section.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import SiteImg from "@/components/media/SiteImg.astro";
import { careerSupport } from "@/data/uni.ts";
---

<Section>
  <div class="career-support_list">
    <div class="career-support_intro margin-trim">
      <Heading tag="h2" variant="h3" class="heading-accent weight-medium margin-bottom-0">
        Your Career,<br />Our <em>Commitment</em>
      </Heading>
      <Paragraph>From Day 1 to your next role, we guide you at every step.</Paragraph>
    </div>
    {careerSupport.map((c) => (
      <article class="career-support_card" data-reveal>
        <div class="career-support_inner">
          <SiteImg class="career-support_image" src={c.image} />
          <div class="career-support_text theme-dark">
            <h3 class="text-style-h4 career-support_title">{c.title}</h3>
            <p class="text-style-small color-faded">{c.text}</p>
          </div>
        </div>
      </article>
    ))}
  </div>
</Section>

<style is:global>
  @layer components {
    .career-support_list {
      width: 100%;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1.25rem;
      @media (width < 64rem) {
        grid-template-columns: 1fr 1fr;
      }
      @media (width < 48rem) {
        grid-template-columns: 1fr;
      }
    }
    .career-support_intro {
      display: flex;
      flex-direction: column;
      justify-content: center;
      @media (width < 64rem) {
        grid-column: 1 / -1;
      }
    }
    .career-support_card {
      padding: 0.5rem;
      border: var(--border-width) dashed #9b6eff;
      border-radius: var(--radius-main);
    }
    .career-support_inner {
      position: relative;
      height: 100%;
      min-height: 20rem;
      overflow: hidden;
      border-radius: var(--radius-medium);
    }
    .career-support_image {
      position: absolute;
      inset: 0;
      height: 100%;
    }
    .career-support_text {
      position: relative;
      height: 100%;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      gap: 0.5rem;
      padding: 0 0.875rem 1.375rem;
      background: linear-gradient(rgb(0 0 0 / 0) 30%, var(--dark-900));
    }
    .career-support_title {
      font-weight: var(--primary-bold);
    }
  }
</style>
