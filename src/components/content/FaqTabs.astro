---
import Section from "@/components/wrapper/Section.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import Tabs from "@/components/interactive/Tabs.astro";
import TabLink from "@/components/interactive/TabLink.astro";
import Accordion from "@/components/interactive/Accordion.astro";
import AccordionItem from "@/components/interactive/AccordionItem.astro";
import Icon from "@/components/media/Icon.astro";
import chevronLeft from "@/assets/icons/chevron-left.svg";
import chevronRight from "@/assets/icons/chevron-right.svg";
import { faqCategories } from "@/data/uni.ts";
---

<Section align="center" gap="0">
  <div slot="background" class="faq-tabs_bg" />
  <div class="faq-tabs_wrap" data-faq>
    <div class="faq-tabs_head margin-trim">
      <Heading tag="h2">Frequently Asked Questions</Heading>
      <Paragraph variant="large" class="color-faded">
        We know you might have some questions before getting started in our platform
      </Paragraph>
    </div>

    <div class="faq-tabs_body">
      <button class="faq-tabs_step" type="button" data-faq-step="-1" aria-label="Previous category">
        <Icon src={chevronLeft} />
      </button>
      <button class="faq-tabs_step next" type="button" data-faq-step="1" aria-label="Next category">
        <Icon src={chevronRight} />
      </button>

      <Tabs id="faq" fit>
        <Fragment slot="links">
          {faqCategories.map((c) => <TabLink>{c.label}</TabLink>)}
        </Fragment>
        {faqCategories.map((c, i) => (
          <div>
            <Accordion variant="box" single={false}>
              {c.items.map((item) => (
                <AccordionItem heading={item.q} data-reveal={i === 0 ? "" : undefined}>
                  <p>{item.a}</p>
                </AccordionItem>
              ))}
            </Accordion>
          </div>
        ))}
      </Tabs>
    </div>
  </div>
</Section>

<script>
  // The arrows beside the tab bar step to the previous or next category.
  document.querySelectorAll<HTMLElement>("[data-faq]").forEach((faq) => {
    const links = [...faq.querySelectorAll<HTMLButtonElement>(".tabs_link")];
    faq.querySelectorAll<HTMLButtonElement>("[data-faq-step]").forEach((arrow) => {
      arrow.addEventListener("click", () => {
        const current = links.findIndex((link) => link.classList.contains("is-active"));
        links[current + Number(arrow.dataset.faqStep)]?.click();
      });
    });
  });
</script>

<style is:global>
  @layer components {
    .faq-tabs_bg {
      background-color: var(--background-2);
    }
    .faq-tabs_wrap {
      width: 100%;
      max-width: var(--max-width-medium);
      display: flex;
      flex-direction: column;
      gap: 3rem;
    }
    .faq-tabs_head {
      max-width: var(--max-width-small);
      margin-inline: auto;
    }
    .faq-tabs_body {
      position: relative;
      text-align: start;
      & .tabs_wrap {
        gap: 2rem;
      }
      & .tabs_link {
        padding-inline: 0.5rem;
        &:first-child {
          flex: none;
          padding-inline: 2rem;
        }
      }
    }
    .faq-tabs_step {
      position: absolute;
      top: 0;
      left: -3.25rem;
      width: 3rem;
      height: 3rem;
      display: grid;
      place-items: center;
      color: var(--purple-400);
      &.next {
        left: auto;
        right: -3.25rem;
      }
      @media (width < 64rem) {
        display: none;
      }
    }
  }
</style>
