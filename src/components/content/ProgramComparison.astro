---
/** Comparison table: this degree against a traditional one. */
import Heading from "@/components/typography/Heading.astro";
import Button from "@/components/Button.astro";
import Icon from "@/components/media/Icon.astro";
import { programIcon } from "@/utils/programIcons.ts";

interface Props {
  comparison: {
    muted: string;
    accent: string;
    dimension: string;
    ours: string;
    theirs: string;
    iconOurs: string | null;
    iconTheirs: string | null;
    iconYes: string | null;
    iconNo: string | null;
    rows: readonly { label: string; ours: string; theirs: string }[];
    button: string;
  };
}

const { comparison: c } = Astro.props;
---

<section class="program-compare_wrap">
  <Heading tag="h2" variant="h2" class="margin-top-0 alignment-center">
    <span class="program-compare_muted">{c.muted}</span> vs. <span class="program-gradient">{c.accent}</span>
  </Heading>
  <div class="program-compare_scroll">
    <table class="program-compare_table">
      <thead>
        <tr>
          <th scope="col" class="program-compare_dimension">{c.dimension}</th>
          <th scope="col" class="program-compare_head is-ours"><Icon src={programIcon(c.iconOurs)} />{c.ours}</th>
          <th scope="col" class="program-compare_head"><Icon src={programIcon(c.iconTheirs)} />{c.theirs}</th>
        </tr>
      </thead>
      <tbody>
        {c.rows.map((r) => (
          <tr>
            <th scope="row">{r.label}</th>
            <td class="is-ours"><span class="program-compare_cell"><Icon src={programIcon(c.iconYes)} />{r.ours}</span></td>
            <td><span class="program-compare_cell"><Icon src={programIcon(c.iconNo)} />{r.theirs}</span></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <div class="program-compare_action">
    <Button element="link" href="#header">{c.button}</Button>
  </div>
</section>

<style is:global>
  @layer components {
    .program-compare_wrap {
      padding: var(--section-space-medium) var(--site-margin);
      background-color: var(--brand-soft);
      color: var(--dark-900);
    }
    .program-compare_muted {
      color: rgb(0 0 0 / 0.3);
    }
    .program-compare_scroll {
      max-width: var(--max-width-medium);
      margin: 3rem auto 0;
      overflow-x: auto;
    }
    .program-compare_table {
      width: 100%;
      min-width: 40rem;
      border-collapse: collapse;
      table-layout: fixed;
      & thead tr {
        border-bottom: var(--border-width) solid rgb(0 0 0 / 0.5);
      }
      & tbody tr + tr {
        border-top: var(--border-width) solid rgb(0 0 0 / 0.1);
      }
      & th,
      & td {
        text-align: start;
        vertical-align: middle;
      }
      & tbody th {
        width: 20%;
        font-weight: var(--primary-semibold);
      }
      & td {
        padding: 1rem 1.5rem;
        & .icon {
          width: 1.5rem;
        }
      }
      & td.is-ours {
        border-inline: var(--border-width) solid #17b26a;
        background-color: var(--light-100);
        & .icon {
          color: #17b26a;
        }
      }
      & td:not(.is-ours) .icon {
        color: var(--brand-red);
      }
      & tbody tr:last-child td.is-ours {
        border-bottom: var(--border-width) solid #17b26a;
      }
    }
    .program-compare_cell {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }
    .program-compare_dimension {
      width: 20%;
      font-size: 1.25rem;
      font-weight: var(--primary-semibold);
    }
    .program-compare_head {
      padding: 1.5rem;
      font-size: 1.25rem;
      font-weight: var(--primary-semibold);
      line-height: 1.2;
      text-align: center !important;
      & .icon {
        width: 2rem;
        margin: 0 auto 1.5rem;
      }
      &.is-ours {
        border: var(--border-width) solid #17b26a;
        border-bottom: 0;
        border-radius: 1.5rem 1.5rem 0 0;
        background-color: var(--light-100);
      }
    }
    .program-compare_action {
      display: flex;
      justify-content: center;
      margin-top: 2.5rem;
    }
  }
</style>
