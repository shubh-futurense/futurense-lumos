---
import Section from "@/components/wrapper/Section.astro";
import Heading from "@/components/typography/Heading.astro";
import Icon from "@/components/media/Icon.astro";
import SiteImg from "@/components/media/SiteImg.astro";
import linkedinSquare from "@/assets/icons/linkedin-square.svg";
import { leapStories } from "@/data/uni.ts";
---

<Section align="center" gap="8">
  <Heading tag="h2" class="heading-accent">Those who <strong>Took the Leap</strong></Heading>
  <div class="stories-leap_list">
    {leapStories.map((s) => (
      <article class="stories-leap_card" data-reveal>
        <div class="stories-leap_inner">
          <div class="stories-leap_head">
            <SiteImg class="stories-leap_photo" src={s.photo} alt={s.name} size={80} />
            <div>
              <h3 class="stories-leap_name">{s.name}</h3>
              <p class="stories-leap_now">{s.now}</p>
            </div>
            <a href={s.linkedin} target="_blank" rel="noopener" class="stories-leap_linkedin" aria-label={`${s.name} on LinkedIn`}>
              <Icon src={linkedinSquare} />
            </a>
          </div>
          <div class="stories-leap_journey">
            <div class="stories-leap_step">
              <p class="stories-leap_label">Pre Futurense</p>
              <div>
                {s.before.role && <p class="stories-leap_role">{s.before.role}</p>}
                <p class="stories-leap_company">{s.before.company}</p>
              </div>
            </div>
            <p class="stories-leap_change">
              {s.change}
              <svg viewBox="0 0 22 9" fill="none" aria-hidden="true">
                <path d="M0.5 0.5 4 4.5 0.5 8.5M9.5 0.5 13 4.5 9.5 8.5M18.5 0.5 22 4.5 18.5 8.5" stroke="currentColor" stroke-width="1.4" />
              </svg>
            </p>
            <div class="stories-leap_step">
              <p class="stories-leap_label">Currently</p>
              <div>
                {s.after.role && <p class="stories-leap_role">{s.after.role}</p>}
                <p class="stories-leap_company">{s.after.company}</p>
              </div>
            </div>
          </div>
        </div>
      </article>
    ))}
  </div>
</Section>

<style is:global>
  @layer components {
    .stories-leap_list {
      width: 100%;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
      text-align: start;
      @media (width < 64rem) {
        grid-template-columns: 1fr 1fr;
      }
      @media (width < 48rem) {
        grid-template-columns: 1fr;
      }
    }
    .stories-leap_card {
      padding: 0.5rem;
      border: var(--border-width) dashed #9b6eff;
      border-radius: var(--radius-main);
      background-color: var(--background);
    }
    .stories-leap_inner {
      height: 100%;
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      padding: 0.75rem;
      border-radius: 0.75rem;
      background: linear-gradient(#d2bdff, rgb(210 189 255 / 0));
    }
    .stories-leap_head {
      display: grid;
      grid-template-columns: 5rem 1fr 1.5rem;
      align-items: center;
      gap: 1rem;
    }
    .stories-leap_photo {
      width: 5rem;
      height: 5rem;
      border-radius: 0.75rem;
    }
    .stories-leap_name {
      font-size: var(--h4);
      font-weight: var(--primary-semibold);
      line-height: 1.3;
    }
    .stories-leap_now,
    .stories-leap_role,
    .stories-leap_change {
      color: var(--slate-800);
    }
    .stories-leap_linkedin {
      align-self: start;
      color: var(--text);
    }
    .stories-leap_journey {
      display: grid;
      grid-template-columns: 1fr auto 1.5fr;
      align-items: end;
      gap: 1.125rem;
      margin-top: 1.5rem;
    }
    .stories-leap_step {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
      align-self: stretch;
    }
    .stories-leap_label {
      font-size: 0.75rem;
      font-weight: var(--primary-medium);
      color: #727a8f;
    }
    .stories-leap_role,
    .stories-leap_change {
      font-size: var(--text-small);
    }
    .stories-leap_company {
      font-size: var(--text-large);
      font-weight: var(--primary-bold);
      line-height: 1.4;
      margin-top: 0.25rem;
    }
    .stories-leap_change {
      display: flex;
      align-items: center;
      gap: 0.375rem;
      margin-bottom: 0.8rem;
      font-weight: var(--primary-medium);
      white-space: nowrap;
      & svg {
        width: 1.3rem;
        color: var(--purple-400);
      }
    }
  }
</style>
