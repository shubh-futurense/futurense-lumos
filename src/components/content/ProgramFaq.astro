---
/** Frequently asked questions as dropdowns. */
import Heading from "@/components/typography/Heading.astro";
import Accordion from "@/components/interactive/Accordion.astro";
import AccordionItem from "@/components/interactive/AccordionItem.astro";

interface Props {
  faq: { title: string; text: string; items: readonly { q: string; a: string }[] };
}

const { faq } = Astro.props;
---

<section class="program-faq_wrap">
  <div class="program-faq_head">
    <Heading class="margin-top-0" tag="h2" variant="h2">{faq.title}</Heading>
    <p>{faq.text}</p>
  </div>
  <div class="program-faq_list">
    <Accordion variant="box" single={false}>
      {faq.items.map((f) => (
        <AccordionItem heading={f.q}>
          <Fragment set:html={f.a} />
        </AccordionItem>
      ))}
    </Accordion>
  </div>
</section>

<style is:global>
  @layer components {
    .program-faq_wrap {
      padding: var(--section-space-medium) var(--site-margin) calc(var(--section-space-medium) + 1rem);
      background-color: var(--light-200);
      color: var(--dark-900);
    }
    .program-faq_head {
      text-align: center;
      & p {
        margin-top: 1rem;
        font-size: var(--text-large);
        line-height: 1.4;
        color: #52606d;
      }
    }
    .program-faq_list {
      max-width: var(--max-width-medium);
      margin: 3rem auto 0;
      & .accordion_title {
        font-size: 1.125rem;
        font-weight: var(--primary-semibold);
      }
      & .accordion_body {
        color: #323e4a;
        & p + p {
          margin-top: 0.5rem;
        }
      }
    }
  }
</style>
