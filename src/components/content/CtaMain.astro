---
import Section from "@/components/wrapper/Section.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import Button from "@/components/Button.astro";
import { cta } from "@/data/uni.ts";
import { img } from "@/data/site.ts";
---

<Section theme="dark">
  <div slot="background" class="cta-main_bg" />
  <div class="cta-main_card theme-brand margin-trim" style={`--_bg: url('${img(cta.background)}');`}>
    <Heading tag="h2" variant="h3">{cta.title}</Heading>
    <Paragraph variant="large" maxWidth={52}>{cta.text}</Paragraph>
    <Button element="link" href={cta.button.href}>{cta.button.label}</Button>
  </div>
</Section>

<style is:global>
  @layer components {
    .cta-main_bg {
      background-color: var(--dark-900);
    }
    .cta-main_card {
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1.5rem;
      padding: 4rem;
      border-radius: var(--radius-medium);
      background: var(--_bg) center / cover, var(--purple-400);
      text-align: center;
      @media (width < 48rem) {
        padding: 3rem 1.25rem;
      }
    }
  }
</style>
