---
import { SITE_NAME, SITE_DESCRIPTION, SITE_URL } from "@/consts.ts";
import { isNoindexRoute } from "@/utils/seo.ts";
import { withBase } from "@/utils/base.ts";
import type { SeoProps } from "@/types.ts";

type Props = SeoProps;

const {
  title,
  description = SITE_DESCRIPTION,
  image = withBase("og-image.jpg"),
  type = "website",
  noindex,
} = Astro.props;

// The page path without the GitHub Pages sub-folder, e.g. "/uni".
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const path = Astro.url.pathname.slice(base.length).replace(/\/$/, "") || "/";

const isNoindex = noindex ?? isNoindexRoute(path);

// Titles that already name the brand are used as they are.
const pageTitle = !title ? SITE_NAME : title.includes(SITE_NAME) ? title : `${title} | ${SITE_NAME}`;

// Canonical always points at futurense.com, so preview copies never compete with the real site.
const canonical = new URL(path, SITE_URL);
const socialImage = new URL(image, Astro.site);
---

<meta charset="utf-8" />
<style is:inline>
  @layer base, patterns, components, utilities;
</style>
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="preconnect" href="https://cdn.prod.website-files.com" crossorigin />
<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{isNoindex && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={socialImage} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage} />

<link rel="icon" type="image/svg+xml" href={withBase("favicon.svg")} />
<link rel="icon" href={withBase("favicon.ico")} />
<meta name="generator" content={Astro.generator} />
