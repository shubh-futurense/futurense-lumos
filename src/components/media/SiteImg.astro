---
/**
 * Image from the Futurense content files.
 * `src` is a short CDN path like "A/123_photo.avif" (see src/data/site.ts).
 * scripts/fetch-assets.mjs downloads these into src/assets/cdn/ as "<webflow-id>.<ext>",
 * so they go through Lumos <Img> and come out as right-sized WebP files.
 * Anything not downloaded (SVG icons, or a failed download) loads straight from the CDN.
 */
import type { HTMLAttributes } from "astro/types";
import Img from "@/components/media/Img.astro";
import { img } from "@/data/site.ts";

type Props = Omit<HTMLAttributes<"img">, "src"> & {
  src: string;
  alt?: string;
  loading?: "lazy" | "eager";
  transparent?: boolean;
  /** Width it displays at, in pixels, for small images like faces and logos. Keeps the files tiny. */
  size?: number;
};

const { src, alt = "", loading = "lazy", transparent = false, size, class: className, ...rest } = Astro.props;

const local = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/cdn/*.{avif,jpg,jpeg,png,webp}",
  { eager: true },
);
const file = src.split("/").pop() ?? "";
const localName = `${file.split("_")[0]}.${file.split(".").pop()?.toLowerCase()}`;
const asset = local[`/src/assets/cdn/${localName}`]?.default;
---

{asset ? (
  size ? (
    <Img src={asset} alt={alt} loading={loading} transparent={transparent} class={className} {...rest} variant="constrained" width={size} height={undefined} sizes={`${size}px`} />
  ) : (
    <Img src={asset} alt={alt} loading={loading} transparent={transparent} class={className} {...rest} width={undefined} height={undefined} />
  )
) : (
  <img
    src={img(src)}
    alt={alt}
    loading={loading}
    decoding="async"
    class:list={["image", transparent && "transparent", className]}
    {...rest}
  />
)}
