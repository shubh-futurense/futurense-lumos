---
// The /uni page. Each line below is one block of the page.
// Reorder, remove or add blocks here like stacking bricks.
import BaseLayout from "@/layouts/BaseLayout.astro";
import HeroUni from "@/components/content/HeroUni.astro";
import PartnersMarquee from "@/components/content/PartnersMarquee.astro";
import ProgramsFinder from "@/components/content/ProgramsFinder.astro";
import TestimonialsStudents from "@/components/content/TestimonialsStudents.astro";
import BenefitsWhy from "@/components/content/BenefitsWhy.astro";
import StoriesLeap from "@/components/content/StoriesLeap.astro";
import CareerSupport from "@/components/content/CareerSupport.astro";
import StepsProcess from "@/components/content/StepsProcess.astro";
import CouncilIntro from "@/components/content/CouncilIntro.astro";
import CouncilMembers from "@/components/content/CouncilMembers.astro";
import StoriesVideo from "@/components/content/StoriesVideo.astro";
import FaqTabs from "@/components/content/FaqTabs.astro";
import MediaSpotlight from "@/components/content/MediaSpotlight.astro";
import CtaMain from "@/components/content/CtaMain.astro";
---

<BaseLayout
  title="Futurense Uni: Your Second Chance At The IIT Dream"
  description="Build an AI-first career with IIT-powered degrees, industry mentorship, and real-world learning."
  overlap
>
  <HeroUni />
  <PartnersMarquee />
  <ProgramsFinder />
  <TestimonialsStudents />
  <BenefitsWhy />
  <StoriesLeap />
  <CareerSupport />
  <StepsProcess />
  <CouncilIntro />
  <CouncilMembers />
  <StoriesVideo />
  <FaqTabs />
  <MediaSpotlight />
  <CtaMain />
</BaseLayout>
